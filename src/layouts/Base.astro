---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Schema from '../components/Schema.astro';

interface Props {
  title?: string;
  description?: string;
  schema?: Record<string, any> | Record<string, any>[];
}

const {
  title = 'Vihren Labs',
  description = 'Operator-grade templates and playbooks for the enterprise IT stack. Built by a 15-year enterprise IT operator.',
  schema,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// The homepage <title> is prime SEO/SERP real estate, so give it a descriptive,
// keyword-bearing title instead of the bare brand name. Every other page keeps
// "<page title> · Vihren Labs". Keyed on the path so pages that omit an explicit
// title prop (and essays whose own titles contain "Vihren Labs") are unaffected.
const isHome = Astro.url.pathname === '/';
const pageTitle = isHome
  ? 'Vihren Labs — Operator-grade templates for the enterprise IT stack'
  : title === 'Vihren Labs'
    ? title
    : `${title} · Vihren Labs`;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Pinterest domain verification (claim vihrenlabs.com) — 2026-05-23 -->
    <meta name="p:domain_verify" content="9376781f57f46bc339fb0ec88999ecb7" />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vihren Labs" />
    <meta property="og:image" content="https://www.vihrenlabs.com/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Vihren Labs — Operator-grade templates for the enterprise IT stack" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://www.vihrenlabs.com/og-image.png" />

    <Schema extra={schema} />

    <!-- Plausible analytics (privacy-first, per BRAND-ENTERPRISE-IT-OPERATOR.md).
         Activates once the vihrenlabs.com site is created in Plausible (founder-action).
         No-op until then; safe to ship. -->
    <script defer data-domain="vihrenlabs.com" src="https://plausible.io/js/script.js"></script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#080E14] text-white font-sans antialiased overflow-x-hidden">
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --navy: #1E3D59;
    --navy-deep: #080E14;
    --navy-mid: #0F1E2E;
    --orange: #E67E22;
    --orange-glow: rgba(230, 126, 34, 0.15);
  }

  h1, h2, h3 {
    font-family: 'Hanken Grotesk', system-ui, sans-serif;
  }

  ::selection {
    background: var(--orange);
    color: #fff;
  }

  /* Blueprint dot-grid — operator-console texture (mockup) */
  .blueprint-pattern {
    background-image: radial-gradient(rgba(51, 65, 85, 0.3) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  /* Subtle radial hero glow */
  .hero-gradient {
    background: radial-gradient(circle at 50% 50%, rgba(230, 126, 34, 0.06) 0%, rgba(8, 14, 20, 0) 70%);
  }

  /* Thin gradient divider */
  .ledger-line {
    background: linear-gradient(90deg, transparent 0%, rgba(51, 65, 85, 0.5) 50%, transparent 100%);
    height: 1px;
    width: 100%;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .marquee-track {
    animation: marquee 28s linear infinite;
    will-change: transform;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .fade-up {
    animation: fadeUp 0.7s ease forwards;
  }

  .fade-up-delay-1 { animation-delay: 0.1s; opacity: 0; }
  .fade-up-delay-2 { animation-delay: 0.25s; opacity: 0; }
  .fade-up-delay-3 { animation-delay: 0.4s; opacity: 0; }

  @keyframes glow-pulse {
    0%, 100% { box-shadow: 0 0 20px rgba(230, 126, 34, 0.3); }
    50%       { box-shadow: 0 0 40px rgba(230, 126, 34, 0.6); }
  }

  .glow-btn {
    animation: glow-pulse 3s ease-in-out infinite;
  }

  .noise-overlay {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-size: 256px 256px;
  }

  .card-hover {
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .card-hover:hover {
    border-color: var(--orange) !important;
    box-shadow: 0 0 30px rgba(230, 126, 34, 0.12);
    transform: translateY(-2px);
  }

  .line-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }
</style>
