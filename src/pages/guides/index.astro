---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf();
});

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Operator Guides — Vihren Labs',
  description:
    'Step-by-step operator guides for the enterprise IT stack — S/4HANA cutover, master data quality audits, EU AI Act readiness, and DORA ICT registers. Answer-first, free to read.',
  url: 'https://www.vihrenlabs.com/guides',
};
---

<Base
  title="Guides · Vihren Labs"
  description="Step-by-step operator guides — S/4HANA cutover checklist, master data quality audit, EU AI Act readiness, DORA Article 28 register. The what and why, free; the done-for-you template, in the catalogue."
  schema={collectionSchema}
>
  <section class="relative px-6 py-24 sm:py-28 border-b border-white/5 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px] rounded-full"
           style="background: radial-gradient(ellipse at center, rgba(30,61,89,0.45) 0%, rgba(8,14,20,0) 70%);"></div>
    </div>
    <div class="relative max-w-3xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Operator guides</span>
      </div>
      <h1 class="font-black text-4xl sm:text-5xl leading-[0.98] tracking-tight mb-6">
        The step-by-step versions.
      </h1>
      <p class="text-white/50 text-lg leading-relaxed">
        How to run the cutover, the master-data audit, the EU regulatory registers — answered
        in operator depth, free. Each guide gives away the what and the why. The done-for-you
        template lives in the <a href="/products" class="text-[#E67E22] hover:underline">catalogue</a>.
      </p>
    </div>
  </section>

  <section class="py-16 px-6">
    <div class="max-w-3xl mx-auto flex flex-col gap-4">
      {guides.map((guide) => (
        <a href={`/guides/${guide.slug}`}
           class="group block border border-white/8 rounded-2xl p-6 hover:border-[#E67E22]/30 transition-colors bg-white/[0.02]">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="font-mono text-[10px] text-[#E67E22] border border-[#E67E22]/30 bg-[#E67E22]/8 px-2 py-0.5 rounded tracking-wider uppercase">{guide.data.line}</span>
          </div>
          <h2 class="font-bold text-xl text-white/90 leading-snug mb-2 group-hover:text-white transition-colors">{guide.data.title}</h2>
          <p class="text-white/45 text-sm leading-relaxed">{guide.data.description}</p>
          <span class="inline-block mt-4 font-mono text-xs text-white/30 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase">Read the guide &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</Base>
