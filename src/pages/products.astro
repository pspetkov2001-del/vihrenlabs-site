---
import Base from '../layouts/Base.astro';
import { products, freeItems, lineGroups, productSlug } from '../data/products';

// Merged 2026-07-22: the old /paths ("Start here") page is folded in here, so
// this is the single catalogue hub. Body is one compact row per product line -
// free entry point, the tools and courses that build on it, then the bundle
// that packages them - which replaces the previous ~24 large product cards.
// Every product stays one click away via its row or the price table below.
// /paths now 301s to /products (see vercel.json).
const tierLabel = { course: 'Course', toolkit: 'Toolkit', bundle: 'Operator pack' };
const tierOrder = { course: 0, toolkit: 1, bundle: 2 };

// Path rows are derived from products.ts (line + tier + price), so adding a
// product updates the page with no upkeep. Bundle saving = sum of the line's
// toolkit prices minus the bundle price.
const priceNum = (s: string): number => {
  const n = parseFloat(String(s).replace(/[^0-9.]/g, ''));
  return isNaN(n) ? 0 : n;
};
const operatorStandard = freeItems.find((f) => f.name.includes('Operator Standard'))!;
const freeFor = (slug: string) =>
  slug === 'ai-governance' ? freeItems.find((f) => f.url.includes('/l/rmkje'))!
  : slug === 'sap' ? freeItems.find((f) => f.url.includes('/l/dlzxfu'))!
  : operatorStandard;

const paths = lineGroups.map((g) => {
  const inLine = products.filter((p) => p.line === g.slug);
  const steps = inLine
    .filter((p) => p.tier !== 'bundle')
    .sort((a, b) => priceNum(a.price) - priceNum(b.price));
  const bundle = inLine.find((p) => p.tier === 'bundle') ?? null;
  const toolkitSum = inLine
    .filter((p) => p.tier === 'toolkit')
    .reduce((s, p) => s + priceNum(p.price), 0);
  const saving = bundle ? Math.round(toolkitSum - priceNum(bundle.price)) : 0;
  const bundleTools = inLine.filter((p) => p.tier === 'toolkit').length;
  return { g, free: freeFor(g.slug), steps, bundle, saving, bundleTools };
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Products - Vihren Labs',
  description:
    'The full Vihren Labs catalogue and where to start: a free entry point per product line, the operator tools and courses that build on it, and the bundle that packages them.',
  url: 'https://www.vihrenlabs.com/products',
};
---

<Base
  title="Products"
  description="Vihren Labs full catalogue - courses, workbooks, playbooks and operator bundles for procurement, programme delivery, SAP, master data, AI adoption & governance, transformation, and EU regulatory compliance. Start free in any line."
  schema={schema}
>
  <!-- ═══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative px-6 py-24 sm:py-28 border-b border-white/5 overflow-hidden blueprint-pattern">
    <!-- Radial glow background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full"
           style="background: radial-gradient(ellipse at center, rgba(30, 61, 89,0.5) 0%, rgba(8, 14, 20,0) 70%);">
      </div>
    </div>

    <div class="relative max-w-4xl mx-auto">
      <!-- Eyebrow -->
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Start here · the catalogue</span>
      </div>

      <h1 class="font-black text-4xl sm:text-5xl lg:text-6xl leading-[0.95] tracking-tight mb-6">
        Where to start - and everything there is.
      </h1>

      <p class="text-white/50 text-lg leading-relaxed max-w-2xl mb-4">
        Every line has the same shape: a <span class="text-white/70">free entry point</span>, the operator
        tools and courses that build on it, and the <span class="text-white/70">bundle</span> that packages them
        at a lower price. Start free, go as deep as you need.
      </p>

      <p class="text-white/35 text-sm leading-relaxed max-w-2xl mb-10">
        {products.filter(p => p.tier === 'course').length} courses · {products.filter(p => p.tier !== 'course').length} workbooks, playbooks and operator bundles · {freeItems.length} free downloads. One-time purchase, no subscription.
      </p>

      <a href="https://vihrenlabs.gumroad.com"
         target="_blank" rel="noopener noreferrer"
         class="inline-flex items-center justify-center gap-2 font-mono text-xs text-white/30 hover:text-[#E67E22] transition-colors tracking-wider uppercase border border-white/8 px-5 py-2.5 rounded-full">
        View all in Gumroad shop
      </a>
    </div>
  </section>

  <!-- ═══ PRICING AT A GLANCE (comparison table — AI-extractable) ═══════
       Collapsed by default so it adds no visual weight, but every product,
       price and tier stays in the HTML for crawlers and AI assistants. ═══ -->
  <section class="py-12 px-6 border-b border-white/5">
    <div class="max-w-6xl mx-auto">
      <details class="group rounded-2xl border border-white/8 bg-white/[0.02]">
        <summary class="flex items-center justify-between gap-4 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden px-6 py-5 hover:bg-white/[0.03] transition-colors">
          <span class="flex items-center gap-3 flex-wrap">
            <span class="w-8 h-px bg-[#E67E22]"></span>
            <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Compare every product &amp; price in one table</span>
          </span>
          <span class="font-mono text-base text-white/30 group-open:rotate-180 transition-transform">&darr;</span>
        </summary>
        <div class="px-6 pb-6">
          <p class="text-white/40 text-sm max-w-2xl mb-6 leading-relaxed">
            Every product, one table - single-operator and team pricing, grouped by line. One-time purchase, no subscription.
          </p>
          <div class="overflow-x-auto rounded-2xl border border-white/8">
        <table class="w-full text-left border-collapse text-sm">
          <thead>
            <tr class="bg-white/[0.03] text-white/45 font-mono text-[11px] uppercase tracking-wider">
              <th class="py-3 px-4 font-medium">Product</th>
              <th class="py-3 px-4 font-medium">Type</th>
              <th class="py-3 px-4 font-medium text-right">Single</th>
              <th class="py-3 px-4 font-medium text-right">Team</th>
            </tr>
          </thead>
          <tbody>
            {lineGroups.map((group) => {
              const lineProducts = products
                .filter((p) => p.line === group.slug)
                .sort((a, b) => tierOrder[a.tier] - tierOrder[b.tier]);
              if (lineProducts.length === 0) return null;
              return (
                <Fragment>
                  <tr class="bg-white/[0.04] border-t border-white/8">
                    <th colspan="4" scope="colgroup" class="py-2.5 px-4 text-left font-mono text-[11px] text-[#E67E22] uppercase tracking-[0.15em]">{group.title}</th>
                  </tr>
                  {lineProducts.map((p) => (
                    <tr class="border-t border-white/5 hover:bg-white/[0.02] transition-colors">
                      <td class="py-3 px-4">
                        <a href={`/products/${productSlug(p.name)}`} class="text-white/85 hover:text-[#E67E22] transition-colors font-medium">{p.name}</a>
                      </td>
                      <td class="py-3 px-4 text-white/45">{tierLabel[p.tier]}</td>
                      <td class="py-3 px-4 text-right text-white/90 font-semibold whitespace-nowrap">{p.price}</td>
                      <td class="py-3 px-4 text-right text-white/40 whitespace-nowrap">{p.team || '-'}</td>
                    </tr>
                  ))}
                </Fragment>
              );
            })}
            <tr class="bg-white/[0.04] border-t border-white/8">
              <th colspan="4" scope="colgroup" class="py-2.5 px-4 text-left font-mono text-[11px] text-[#E67E22] uppercase tracking-[0.15em]">Free resources</th>
            </tr>
            {freeItems.map((p) => (
              <tr class="border-t border-white/5 hover:bg-white/[0.02] transition-colors">
                <td class="py-3 px-4">
                  <a href={p.url} target="_blank" rel="noopener noreferrer" class="text-white/85 hover:text-[#E67E22] transition-colors font-medium">{p.name}</a>
                </td>
                <td class="py-3 px-4 text-white/45">Download</td>
                <td class="py-3 px-4 text-right text-white/90 font-semibold whitespace-nowrap">{p.price}</td>
                <td class="py-3 px-4 text-right text-white/40 whitespace-nowrap">-</td>
              </tr>
            ))}
          </tbody>
        </table>
          </div>
          <p class="text-white/30 text-xs mt-4 font-mono">All prices one-time · single-operator and team licences · instant download on Gumroad.</p>
        </div>
      </details>
    </div>
  </section>

  <!-- ═══ THE LINES (one compact row each) ══════════════════════════════
       Replaces the former courses grid + free grid + line-grouped card
       catalogue: each row already surfaces the line's free entry point,
       its courses and toolkits, and its bundle. ═══════════════════════ -->
  <section class="py-14 px-6">
    <div class="max-w-5xl mx-auto space-y-5">
      {paths.map((P) => (
        <div class="rounded-2xl border border-white/8 bg-white/[0.02] p-6 sm:p-7">
          <div class="mb-5">
            <a href={`/lines/${P.g.slug}`} class="group inline-flex items-baseline gap-2">
              <h2 class="font-black text-xl sm:text-2xl text-white/90 group-hover:text-[#E67E22] transition-colors leading-tight">{P.g.title}</h2>
              <span class="font-mono text-[10px] text-white/30 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase">line</span>
            </a>
          </div>

          <div class="flex flex-col lg:flex-row lg:items-stretch gap-3">
            <!-- start free -->
            <a href={P.free.url} target="_blank" rel="noopener noreferrer"
               class="group shrink-0 lg:w-56 flex flex-col justify-center rounded-xl border border-[#E67E22]/30 bg-[#E67E22]/[0.05] hover:bg-[#E67E22]/[0.09] transition-colors p-4">
              <span class="font-mono text-[10px] text-[#E67E22] mb-1.5 tracking-wider uppercase">Start free</span>
              <span class="font-bold text-sm text-white/90 leading-snug">{P.free.name}</span>
              <span class="font-mono text-[10px] text-white/35 group-hover:text-[#E67E22] transition-colors mt-2 tracking-wider uppercase">Get it</span>
            </a>

            <div class="hidden lg:flex items-center text-white/20 font-mono text-lg shrink-0" aria-hidden="true">&rarr;</div>

            <!-- the pieces -->
            <div class="flex-1 grid grid-cols-1 sm:grid-cols-2 gap-2 content-start">
              {P.steps.map((s) => (
                <a href={`/products/${productSlug(s.name)}`}
                   class="group flex items-center justify-between gap-3 rounded-xl border border-white/8 hover:border-[#E67E22]/30 bg-white/[0.02] transition-colors px-4 py-3">
                  <span class="min-w-0">
                    <span class="font-mono text-[10px] text-white/30 tracking-wider uppercase">{tierLabel[s.tier]}</span>
                    <span class="block font-bold text-sm text-white/85 leading-snug truncate group-hover:text-white">{s.name}</span>
                  </span>
                  <span class="font-black text-sm text-white/80 whitespace-nowrap shrink-0">{s.price}</span>
                </a>
              ))}
            </div>
          </div>

          <!-- bundle convergence -->
          {P.bundle && (
            <a href={`/products/${productSlug(P.bundle.name)}`}
               class="group mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 rounded-xl border border-[#E67E22]/25 bg-[#E67E22]/[0.04] hover:border-[#E67E22]/50 hover:bg-[#E67E22]/[0.07] transition-colors px-5 py-4">
              <span class="min-w-0">
                <span class="font-mono text-[10px] text-[#E67E22] tracking-wider uppercase">Bundle · all {P.bundleTools} in one</span>
                <span class="block font-bold text-sm sm:text-base text-white/90 leading-snug">{P.bundle.name}</span>
              </span>
              <span class="flex items-center gap-3 shrink-0">
                {P.saving > 0 && <span class="font-mono text-[10px] text-[#E67E22] border border-[#E67E22]/30 bg-[#E67E22]/10 px-2 py-0.5 rounded tracking-wider uppercase">save ${P.saving}</span>}
                <span class="font-black text-lg text-white/95">{P.bundle.price}</span>
                <span class="font-mono text-xs text-white/30 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase">Details</span>
              </span>
            </a>
          )}
        </div>
      ))}
    </div>
  </section>

</Base>
