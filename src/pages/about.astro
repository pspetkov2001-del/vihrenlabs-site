---
import Base from '../layouts/Base.astro';

const clusters = [
  {
    period: '2011 – 2016',
    tag: 'Transformation operator',
    color: '#2980B9',
    items: [
      'IBM Global Process Services — Operations Manager CRM, 35-FTE team, Madrid',
      'Sharp Electronics Spain → IBM Kraków — Transition Manager, 30 FTEs',
      'Sofia SSC 300 → 700 FTEs across 12 legal entities',
      'Finance AP/EP global process standardisation, SOX-aligned controls',
    ],
  },
  {
    period: '2017 – 2023',
    tag: 'Vendor-side honest broker',
    color: '#E67E22',
    items: [
      'EMEA vendor reporting for the largest hardware and software vendors in the world',
      'Vendor content quality, distribution economics, procurement patterns from inside',
      'Saw what buyers never see: the margin structure, the content gaps, the renewal mechanics',
    ],
  },
  {
    period: '2023 – present',
    tag: 'Master Data Transformation',
    color: '#27AE60',
    items: [
      'Global master-data transformation across the Product, Vendor, and Customer domains, in enterprise IT distribution',
      'Mandate: manual product & SKU creation → AI-driven, rules-based, governed automation that holds at scale',
      'Vendor + associate catalogue platform: ingestion → standardisation → enrichment → attribute rules → dynamic SKU creation → touchless quoting',
      'Operating model end to end — data owners, stewards, decision rights, controls — with agile delivery and engineering partnership',
      'Shipped the Vihren Labs catalogue alongside the day job — 22 paid products + 2 free, across 7 lines',
    ],
  },
];

const credentials = [
  'Master data transformation & governance',
  'PRINCE2 Practitioner',
  'Six Sigma',
  '15 years in enterprise IT',
  'Bulgarian · English · Spanish',
  'Sofia, Bulgaria',
  'Vihren Labs EOOD',
];

const lines = [
  { name: 'Procurement & Vendor Management', sub: 'TCO, renewals, RFPs', color: '#E67E22' },
  { name: 'Digital Transformation', sub: 'ERP modernisation, automation, AI adoption', color: '#2980B9' },
  { name: 'SAP / ERP Operations', sub: 'S/4HANA cutover, hypercare, migration', color: '#27AE60' },
  { name: 'Master Data & Catalog', sub: 'Quality audits, maturity, governance', color: '#E67E22' },
  { name: 'AI Adoption & Governance', sub: 'Agent readiness, governance register, vendor TCO', color: '#2980B9' },
  { name: 'Transformation & SSC/GBS', sub: 'Transition workbooks, PMO, GPO models', color: '#2980B9' },
  { name: 'EU Regulatory & Compliance', sub: 'EU AI Act, ICT third-party-risk registers, real article citations', color: '#27AE60' },
];
---

<Base
  title="About"
  description="Petko Petkov — the operator behind Vihren Labs. 15 years in enterprise IT distribution, SAP, Master Data Management, and shared services transformation."
>
  <div class="noise-overlay" aria-hidden="true"></div>

  <!-- ═══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative py-28 px-6 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full opacity-10"
           style="background: radial-gradient(ellipse at top right, rgba(30,61,89,0.8), transparent 70%);">
      </div>
    </div>

    <div class="relative max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-8">The operator behind Vihren Labs</p>
        <h1 class="font-black text-6xl sm:text-7xl leading-[0.9] tracking-tight mb-6">
          Petko<br />Petkov
        </h1>
        <p class="text-white/50 text-base leading-relaxed max-w-lg mb-4">
          Fifteen years inside enterprise IT — and on both sides of every deal. Ran SSC/GBS transitions in Spain, Poland, and Bulgaria when shared-services consolidation was hitting its second peak. Ran finance workflows when SOX was teeth-on-the-floor. Sat on the vendor-distribution side of EMEA reporting across the world's largest hardware and software vendors.
        </p>
        <p class="text-white/35 text-sm leading-relaxed max-w-lg mb-10">
          More recently, leading enterprise master-data transformation — turning manual product and SKU creation into an automated, rules-based, governed pipeline, from vendor-catalogue ingestion through to touchless quoting and ordering. Vihren Labs is the catalogue of what that arc — operator → vendor → distributor — actually taught me: 22 paid products plus 2 free downloads, across seven product lines, written from the third seat of every deal.
        </p>
        <div class="flex flex-wrap gap-3 mb-10">
          <a
            href="mailto:hello@vihrenlabs.com"
            class="inline-flex items-center gap-2 font-mono text-xs text-white/40 border border-white/10 hover:border-white/30 px-4 py-2 rounded-full transition-colors"
          >
            hello@vihrenlabs.com
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {credentials.map(c => (
            <span class="font-mono text-xs text-white/30 border border-white/8 px-3 py-1.5 rounded-full">
              {c}
            </span>
          ))}
        </div>
      </div>

      <!-- Avatar -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative">
          <div class="w-56 h-56 sm:w-72 sm:h-72 rounded-3xl flex items-center justify-center"
               style="background: linear-gradient(135deg, #1E3D59, #0F1E2E); border: 1px solid rgba(255,255,255,0.08);">
            <span class="font-black text-7xl sm:text-9xl text-[#E67E22] font-mono">PP</span>
          </div>
          <div class="absolute -bottom-4 -right-4 bg-[#E67E22] text-white font-mono text-xs px-4 py-2 rounded-xl">
            Sofia, BG
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE RARE POSITION ═════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-[#0A1520] border-y border-white/5">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-8">Why this matters</p>
      <blockquote class="font-black text-3xl sm:text-4xl lg:text-5xl leading-tight text-white/90">
        "Most enterprise-IT content is written by consultants who manage projects or vendors who sell products. Vihren Labs is written from the third seat."
      </blockquote>
      <p class="text-white/40 text-lg mt-8 max-w-2xl mx-auto">
        The operator who has sat on both the vendor-distribution side AND the buyer side of every deal — and watched what actually breaks at 4 AM on cutover weekend.
      </p>
    </div>
  </section>

  <!-- ═══ THREE-CLUSTER TIMELINE ════════════════════════════════════════ -->
  <section class="py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">Career arc</p>
      <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-16">
        Three clusters.<br />
        <span class="text-white/30">One through line.</span>
      </h2>

      <div class="space-y-6">
        {clusters.map((c) => (
          <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-8 sm:p-10 card-hover">
            <div class="flex items-start gap-6 flex-wrap sm:flex-nowrap">
              <div class="flex-shrink-0 sm:w-36">
                <div class="font-mono text-xs uppercase tracking-widest mb-2" style={`color: ${c.color}`}>
                  {c.period}
                </div>
                <div class="h-0.5 w-12" style={`background: ${c.color}`}></div>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-bold text-xl text-white mb-5">{c.tag}</h3>
                <ul class="space-y-3">
                  {c.items.map(item => (
                    <li class="flex items-start gap-3 text-white/50 text-sm leading-relaxed">
                      <span class="flex-shrink-0 mt-1.5 w-1 h-1 rounded-full" style={`background: ${c.color}`}></span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SIX PRODUCT LINES ═════════════════════════════════════════════ -->
  <section class="py-28 px-6 bg-[#0A1520] border-y border-white/5">
    <div class="max-w-6xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">The catalogue</p>
      <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-4">
        Seven product lines.<br />
        <span class="text-white/30">Fifteen years, packaged.</span>
      </h2>
      <p class="text-white/40 text-base leading-relaxed max-w-2xl mb-12">
        What those years actually taught me, in formats you can open on Monday and ship by Friday — structured Excel workbooks, operator playbooks, regulatory registers, transformation toolkits, and full self-paced courses.
      </p>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {lines.map(l => (
          <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-7 card-hover">
            <div class="h-0.5 w-10 mb-5" style={`background: ${l.color}`}></div>
            <h3 class="font-bold text-lg text-white mb-2">{l.name}</h3>
            <p class="text-white/45 text-sm leading-relaxed">{l.sub}</p>
          </div>
        ))}
      </div>

      <div class="mt-12">
        <a href="/products" class="inline-flex items-center gap-2 text-[#E67E22] font-medium text-sm hover:gap-4 transition-all">
          Browse all seven lines <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ ALSO BUILDING ═════════════════════════════════════════════════ -->
  <section class="py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">Also building</p>
      <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-4">
        Three lanes.<br />
        <span class="text-white/30">One operator.</span>
      </h2>
      <p class="text-white/40 text-base leading-relaxed max-w-2xl mb-12">
        Vihren Labs is the templates lane. Two live products run in parallel — same operator philosophy, different audiences.
      </p>

      <div class="grid lg:grid-cols-2 gap-6">
        <!-- Hintly card -->
        <a
          href="https://hintlyapp.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group block rounded-2xl border border-white/5 bg-white/[0.02] p-8 sm:p-10 card-hover"
        >
          <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <p class="font-mono text-[#27AE60] text-xs tracking-[0.18em] uppercase">Consumer SaaS · K-12 parents</p>
            <span class="inline-flex items-center gap-2 font-mono text-[10px] text-white/40 border border-white/10 px-2.5 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-[#27AE60] animate-pulse"></span>
              Live at hintlyapp.com
            </span>
          </div>
          <h3 class="font-black text-3xl text-white mb-4 group-hover:text-[#E67E22] transition-colors">Hintly</h3>
          <p class="text-white/50 text-sm leading-relaxed mb-8">
            AI homework hints for kids. Calm, parent-respecting, no streak guilt. Built on the lesson that consultant-speak fails the people who actually have to deliver — same operator philosophy as Vihren Labs, different audience.
          </p>
          <span class="inline-flex items-center gap-2 text-[#E67E22] font-medium text-sm group-hover:gap-4 transition-all">
            Visit Hintly <span>&rarr;</span>
          </span>
        </a>

        <!-- Master Data Management Product Engine card -->
        <a
          href="https://mdm-engine.vercel.app"
          target="_blank"
          rel="noopener noreferrer"
          class="group block rounded-2xl border border-white/5 bg-white/[0.02] p-8 sm:p-10 card-hover"
        >
          <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
            <p class="font-mono text-[#2980B9] text-xs tracking-[0.18em] uppercase">B2B SaaS · IT distributors</p>
            <span class="inline-flex items-center gap-2 font-mono text-[10px] text-white/40 border border-white/10 px-2.5 py-1 rounded-full">
              <span class="w-1.5 h-1.5 rounded-full bg-[#2980B9] animate-pulse"></span>
              Live
            </span>
          </div>
          <h3 class="font-black text-3xl text-white mb-4 group-hover:text-[#E67E22] transition-colors">Master Data Management Product Engine</h3>
          <p class="text-white/50 text-sm leading-relaxed mb-8">
            AI-driven master data management for B2B distributors. The platform that powers the catalogue operations Vihren Labs templates teach — built from inside enterprise IT distribution, packaged for the mid-market.
          </p>
          <span class="inline-flex items-center gap-2 text-[#E67E22] font-medium text-sm group-hover:gap-4 transition-all">
            See it <span>&rarr;</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT VIHREN LABS IS NOT ═══════════════════════════════════════ -->
  <section class="py-20 px-6 bg-[#0A1520] border-y border-white/5">
    <div class="max-w-6xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-10">Guardrails</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { label: 'Not a consulting firm', sub: 'No engagements. No project work. Templates only.' },
          { label: 'Not a vendor pitch', sub: 'Nothing sold here is a platform or upsell.' },
          { label: 'Not a think-tank', sub: 'Every claim is grounded in hands-on execution.' },
          { label: 'Not a content machine', sub: 'One newsletter. One LinkedIn. That\'s it.' },
        ].map(item => (
          <div class="p-6 rounded-xl border border-white/5 bg-white/[0.015]">
            <div class="text-[#E67E22] font-mono text-xs mb-3">&#8722;</div>
            <h3 class="font-semibold text-white/80 text-sm mb-2">{item.label}</h3>
            <p class="text-white/35 text-xs leading-relaxed">{item.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ════════════════════════════════════════════════════════════ -->
  <section class="py-28 px-6 text-center">
    <div class="max-w-xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-6">Ready to work</p>
      <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-6">
        See what fifteen<br />years looks like<br />
        <span class="text-white/30">in a spreadsheet.</span>
      </h2>
      <a
        href="https://vihrenlabs.gumroad.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#E67E22]/20 border border-[#E67E22]/40 text-[#E67E22] font-bold px-10 py-5 rounded-full text-base hover:bg-[#E67E22]/30 transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-[#E67E22] animate-pulse flex-shrink-0"></span>
        Browse the catalogue on Gumroad
      </a>
      <p class="text-white/30 text-sm mt-6">
        <a href="/#newsletter" class="hover:text-[#E67E22] transition-colors underline underline-offset-4">Join the newsletter</a> for weekly notes from inside enterprise IT.
      </p>
    </div>
  </section>
</Base>
