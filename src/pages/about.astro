---
import Base from '../layouts/Base.astro';
import { products, freeItems, lineGroups } from '../data/products';

// This page no longer states a product-line COUNT - see the same note in
// index.astro. Four places here carried the count and drifted after the
// 2026-07-22 line fold; D-060 (2026-07-26) replaced them with the two
// front-door category names, so there is no number left to drift. If a count
// ever returns to this page, derive it from lineGroups - never hard-code it.

const clusters = [
  {
    period: '2011 – 2016',
    tag: 'Transformation operator',
    color: '#2980B9',
    items: [
      'Set up global business-process centres and shared services across multiple European countries',
      'Ran multi-country operations moves and offshoring programmes - process design, knowledge transfer',
      'Stood up and scaled multi-entity shared-services centres',
      'Finance AP/EP global process standardisation, SOX-aligned controls',
    ],
  },
  {
    period: '2017 – 2023',
    tag: 'Vendor-side honest broker',
    color: '#2980B9',
    items: [
      'EMEA vendor reporting for the largest hardware and software vendors in the world',
      'Vendor content quality, distribution economics, procurement patterns from inside',
      'Saw what buyers never see: the margin structure, the content gaps, the renewal mechanics',
    ],
  },
  {
    period: '2023 – present',
    tag: 'Master Data Transformation',
    color: '#27AE60',
    items: [
      'Master-data transformation across the Product, Vendor, and Customer domains at enterprise scale',
      'Turning manual product & SKU creation into AI-driven, rules-based, governed automation that holds at scale',
      'The catalogue pipeline pattern: ingestion - standardisation - enrichment - attribute rules - dynamic SKU creation - touchless quoting',
      'Operating model end to end - data owners, stewards, decision rights, controls - with agile delivery and engineering partnership',
      `Shipped the Vihren Labs catalogue alongside the day job - ${products.length} paid products + ${freeItems.length} free, across ${lineGroups.length} lines`,
    ],
  },
];

const credentials = [
  'Master data transformation & governance',
  'PRINCE2 Practitioner',
  'Six Sigma',
  '15 years in enterprise IT',
  'Bulgarian · English · Spanish',
  'Sofia, Bulgaria',
  'Vihren Labs Ltd.',
];

// Line cards below are driven by lineGroups (src/data/products.ts) + its
// `primary` flag, not hand-written here - a hand-written list drifted after
// every line-count change (2026-07-22 fold). Color is a pure display concern
// (not part of the canonical product data), keyed by slug so a reorder of
// lineGroups can't silently mis-map a color to the wrong line.
const lineColors: Record<string, string> = {
  procurement: '#2980B9',
  sap: '#27AE60',
  'master-data': '#2980B9',
  'ai-governance': '#2980B9',
  transformation: '#2980B9',
  regulatory: '#27AE60',
};
const primaryLines = lineGroups.filter((l) => l.primary);
const secondaryLines = lineGroups.filter((l) => !l.primary);
---

<Base
  title="About"
  description="Petko Petkov - the operator behind Vihren Labs. 15 years in enterprise IT, SAP, Master Data Management, and shared services transformation."
>
  <div class="noise-overlay" aria-hidden="true"></div>

  <!-- ═══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative py-28 px-6 overflow-hidden blueprint-pattern">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-0 right-0 w-[600px] h-[600px] rounded-full opacity-10"
           style="background: radial-gradient(ellipse at top right, rgba(30, 61, 89,0.8), transparent 70%);">
      </div>
    </div>

    <div class="relative max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-8">The operator behind Vihren Labs</p>
        <h1 class="font-black text-6xl sm:text-7xl leading-[0.9] tracking-tight mb-6">
          Petko<br />Petkov
        </h1>
        <p class="text-white/50 text-base leading-relaxed max-w-lg mb-4">
          Fifteen years inside enterprise IT - and on both sides of every deal. Ran SSC/GBS transitions across multiple European countries when shared-services consolidation was hitting its second peak. Ran finance workflows when SOX was teeth-on-the-floor. Sat on the vendor-distribution side of EMEA reporting across the world's largest hardware and software vendors.
        </p>
        <p class="text-white/35 text-sm leading-relaxed max-w-lg mb-10">
          More recently, leading enterprise master-data transformation - turning manual product and SKU creation into an automated, rules-based, governed pipeline, from vendor-catalogue ingestion through to touchless quoting and ordering. Vihren Labs is the catalogue of what that arc - operator to vendor to distributor - actually taught me: {products.length} paid products plus {freeItems.length} free downloads, led by master data operations and AI-ready operations, written from the third seat of every deal.
        </p>
        <div class="flex flex-wrap gap-3 mb-10">
          <a
            href="mailto:hello@vihrenlabs.com"
            class="inline-flex items-center gap-2 font-mono text-xs text-white/40 border border-white/10 hover:border-white/30 px-4 py-2 rounded-full transition-colors"
          >
            hello@vihrenlabs.com
          </a>
          <a
            href="https://www.youtube.com/@vihrenlabs"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 font-mono text-xs text-white/40 border border-white/10 hover:border-white/30 px-4 py-2 rounded-full transition-colors"
          >
            YouTube: AI-Ready Operations
          </a>
        </div>
        <div class="flex flex-wrap gap-2">
          {credentials.map(c => (
            <span class="font-mono text-xs text-white/30 border border-white/8 px-3 py-1.5 rounded-full">
              {c}
            </span>
          ))}
        </div>
      </div>

      <!-- Avatar -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative">
          <div class="w-56 h-56 sm:w-72 sm:h-72 rounded-full overflow-hidden"
               style="border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 24px 64px -18px rgba(0,0,0,0.65);">
            <img
              src="/petko-photo.webp"
              alt="Petko Petkov, founder of Vihren Labs"
              width="640"
              height="640"
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-4 -right-4 bg-[#E67E22] text-white font-mono text-xs px-4 py-2 rounded-xl">
            Sofia, BG
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ THE RARE POSITION ═════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-[#0A1520] border-y border-white/5">
    <div class="max-w-4xl mx-auto text-center">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-8">Why this matters</p>
      <blockquote class="font-black text-3xl sm:text-4xl lg:text-5xl leading-tight text-white/90">
        "Most enterprise-IT content is written by consultants who manage projects or vendors who sell products. Vihren Labs is written from the third seat."
      </blockquote>
      <p class="text-white/40 text-lg mt-8 max-w-2xl mx-auto">
        The operator who has sat on both the vendor-distribution side AND the buyer side of every deal - and watched what actually breaks at 4 AM on cutover weekend.
      </p>
    </div>
  </section>

  <!-- ═══ THREE-CLUSTER TIMELINE ════════════════════════════════════════ -->
  <section class="py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">Career arc</p>
      <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-16">
        Three clusters.<br />
        <span class="text-white/30">One through line.</span>
      </h2>

      <div class="space-y-6">
        {clusters.map((c) => (
          <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-8 sm:p-10 card-hover">
            <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6">
              <div class="flex-shrink-0 sm:w-36">
                <div class="font-mono text-xs uppercase tracking-widest mb-2" style={`color: ${c.color}`}>
                  {c.period}
                </div>
                <div class="h-0.5 w-12" style={`background: ${c.color}`}></div>
              </div>
              <div class="flex-1 min-w-0 w-full">
                <h3 class="font-bold text-xl text-white mb-5">{c.tag}</h3>
                <ul class="space-y-3">
                  {c.items.map(item => (
                    <li class="flex items-start gap-3 text-white/50 text-sm leading-relaxed">
                      <span class="flex-shrink-0 mt-2 w-1.5 h-1.5 rounded-full" style={`background: ${c.color}`}></span>
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PRODUCT LINES — two categories + adjacent toolkits ═════════════
       Was a hand-written six-line list (drifted after every line-count
       change). Now driven by lineGroups + the `primary` flag it carries
       (src/data/products.ts), so the front-door narrowing (Master Data
       Operations + AI Adoption & Governance) can never fall out of sync
       with the data. Nothing here is hidden or removed - every line still
       renders, fully linked to /lines/[slug]. ═══════════════════ -->
  <section class="py-28 px-6 bg-[#0A1520] border-y border-white/5">
    <div class="max-w-6xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">The catalogue</p>
      <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-4">
        Two categories, deep.<br />
        <span class="text-white/30">Fifteen years, packaged.</span>
      </h2>
      <p class="text-white/40 text-base leading-relaxed max-w-2xl mb-12">
        What those years actually taught me, in formats you can open on Monday and ship by Friday - structured Excel workbooks, operator playbooks, regulatory registers, transformation toolkits, and full self-paced courses.
      </p>

      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-5">Two categories I'm known for</p>
      <div class="grid sm:grid-cols-2 gap-4 mb-14">
        {primaryLines.map(l => (
          <div class="rounded-2xl border border-[#E67E22]/30 bg-[#E67E22]/[0.03] p-7 card-hover">
            <div class="h-0.5 w-10 mb-5" style={`background: ${lineColors[l.slug] ?? '#E67E22'}`}></div>
            <h3 class="font-bold text-lg text-white mb-2">{l.title}</h3>
            <p class="text-white/45 text-sm leading-relaxed">{l.sub}</p>
          </div>
        ))}
      </div>

      <p class="font-mono text-white/40 text-xs tracking-[0.2em] uppercase mb-5">and the adjacent operator toolkits</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {secondaryLines.map(l => (
          <div class="rounded-2xl border border-white/5 bg-white/[0.02] p-7 card-hover">
            <div class="h-0.5 w-10 mb-5" style={`background: ${lineColors[l.slug] ?? '#2980B9'}`}></div>
            <h3 class="font-bold text-lg text-white mb-2">{l.title}</h3>
            <p class="text-white/45 text-sm leading-relaxed">{l.sub}</p>
          </div>
        ))}
      </div>

      <div class="mt-12">
        <a href="/products" class="inline-flex items-center gap-2 text-[#E67E22] font-medium text-sm hover:gap-4 transition-all">
          Browse the full catalogue
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT VIHREN LABS IS NOT ═══════════════════════════════════════ -->
  <section class="py-20 px-6 bg-[#0A1520] border-y border-white/5">
    <div class="max-w-6xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-10">Guardrails</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {[
          { label: 'Not a consulting firm', sub: 'No engagements. No project work. Templates only.' },
          { label: 'Not a vendor pitch', sub: 'Nothing sold here is a platform or upsell.' },
          { label: 'Not a think-tank', sub: 'Every claim is grounded in hands-on execution.' },
          { label: 'Not a content machine', sub: 'One newsletter. One video series. That\'s it.' },
        ].map(item => (
          <div class="p-6 rounded-xl border border-white/5 bg-white/[0.015]">
            <div class="text-[#E67E22] font-mono text-xs mb-3">&#8722;</div>
            <h3 class="font-semibold text-white/80 text-sm mb-2">{item.label}</h3>
            <p class="text-white/35 text-xs leading-relaxed">{item.sub}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ CTA ════════════════════════════════════════════════════════════ -->
  <section class="py-28 px-6 text-center">
    <div class="max-w-xl mx-auto">
      <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-6">Ready to work</p>
      <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-6">
        See what fifteen<br />years looks like<br />
        <span class="text-white/30">in a spreadsheet.</span>
      </h2>
      <a
        href="https://vihrenlabs.gumroad.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#E67E22]/20 border border-[#E67E22]/40 text-[#E67E22] font-mono text-sm font-bold uppercase tracking-widest px-10 py-5 rounded-lg hover:bg-[#E67E22]/30 transition-colors"
      >
        <span class="w-2 h-2 rounded-full bg-[#E67E22] animate-pulse flex-shrink-0"></span>
        Browse the catalogue on Gumroad
      </a>
      <p class="text-white/30 text-sm mt-6">
        <a href="/#newsletter" class="hover:text-[#E67E22] transition-colors underline underline-offset-4">Join the newsletter</a> for weekly notes from inside enterprise IT.
      </p>
      <p class="text-white/20 text-xs mt-10 max-w-md mx-auto leading-relaxed">
        Vihren Labs is an independent educational-publishing business. Views expressed are solely my own and do not represent any current or former employer.
      </p>
    </div>
  </section>
</Base>
