---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const ticker = [
  '15 years in enterprise IT',
  'SAP ECC & S/4HANA',
  'EU AI Act & DORA',
  'PRINCE2 Practitioner',
  'Six Sigma',
  'SSC 300→700 FTEs',
  'Master Data GPO',
  'Fortune-100 IT distribution',
  'EMEA vendor reporting',
  'AI-driven catalog platform',
];

const lines = [
  {
    num: '01',
    name: 'Procurement & Vendor Management',
    sub: 'IT vendor TCO, renewal calendars, negotiation playbooks — from the side of the table that knows what distributors don\'t tell you.',
    tags: ['Excel workbook', 'Ebook', 'Bundle'],
  },
  {
    num: '02',
    name: 'Regulatory & Compliance',
    sub: 'EU AI Act, DORA Article 28, compliance registers with real article citations — not consultant summaries.',
    tags: ['Excel register', 'Starter pack', 'Full tier'],
  },
  {
    num: '03',
    name: 'SAP / ERP Operations',
    sub: 'S/4HANA cutover management, hypercare runbooks, migration readiness — what actually breaks at 3 AM and how to prevent it.',
    tags: ['Excel workbook', 'Playbook ebook', 'Bundle'],
  },
  {
    num: '04',
    name: 'Master Data & Catalog',
    sub: 'Master Data Management maturity diagnostics, SKU enrichment scorecards, AI-readiness audits — for the person accountable for the data, not the consultant reviewing it.',
    tags: ['Maturity assessment', 'Scorecard', 'Ebook'],
  },
  {
    num: '05',
    name: 'Transformation & Shared Services',
    sub: 'Transition management workbooks, SSC standup packs, GPO operating models — drawn from transitions that involved real headcount, real deadlines, and real consequences.',
    tags: ['Workbook', 'Templates', 'Course'],
  },
  {
    num: '06',
    name: 'Digital Transformation',
    sub: 'Operating-model roadmaps, ERP modernisation strategy, process automation, AI adoption, change management, delivery and cloud migration — the strategy-and-delivery layer above the execution toolkits.',
    tags: ['Excel toolkits', 'Playbooks', 'Suite bundle'],
  },
];

// Live products — verified on Gumroad 2026-05-22. Titles/prices per
// Spreadsheet OS Collection/GUMROAD-LISTING-ACTION-PACK.md.
const products = [
  {
    tag: 'Excel workbook',
    name: 'IT Vendor & SaaS Procurement TCO',
    sub: 'Vendor registry, 3-year TCO model, 12-month renewal pipeline, RFP scoring — from the distributor side of the table.',
    price: '$49', team: '$99',
    url: 'https://vihrenlabs.gumroad.com/l/eujpqc',
  },
  {
    tag: 'Ebook',
    name: 'Vendor-Side IT Procurement — The Playbook',
    sub: '8 chapters on how IT distributors and vendors actually price, discount and renew — and how to negotiate against it.',
    price: '$29', team: '$79',
    url: 'https://vihrenlabs.gumroad.com/l/ovyxjl',
  },
  {
    tag: 'Starter pack',
    name: 'EU AI Act SME Compliance Starter',
    sub: 'Article 50 transparency tracker, high-risk register, deployer readiness assessment. Enforcement: 2 Aug 2026.',
    price: '€149', team: '€249',
    url: 'https://vihrenlabs.gumroad.com/l/rqems',
  },
  {
    tag: 'Excel workbook',
    name: 'SAP S/4HANA Migration Cutover Excel',
    sub: '52-check readiness matrix, 46-step cutover run sheet, hypercare runbook. What breaks at 3 AM.',
    price: '$99', team: '$249',
    url: 'https://vihrenlabs.gumroad.com/l/fsslk',
  },
  {
    tag: 'Playbook ebook',
    name: "SAP S/4HANA Migration Playbook",
    sub: "The operator's guide beneath the workbook — phase gates, failure modes, the cutover-week methodology.",
    price: '$39', team: '$99',
    url: 'https://vihrenlabs.gumroad.com/l/bsxhb',
  },
  {
    tag: 'Excel workbook',
    name: 'Master Data Quality Audit Workbook',
    sub: '75 named SAP Master Data Management quality checks, field-level scoring, defect log and remediation tracker.',
    price: '$79', team: '$149',
    url: 'https://vihrenlabs.gumroad.com/l/znhthm',
  },
  {
    tag: 'Assessment',
    name: 'Master Data Management Maturity Assessment',
    sub: '78 anchored questions across 5 domains — a scored, banded read on master-data maturity.',
    price: '$79', team: '$149',
    url: 'https://vihrenlabs.gumroad.com/l/nwbvrn',
  },
  {
    tag: 'Playbook',
    name: 'MDG Operating Model Playbook',
    sub: 'Data owner + steward roles, RACI and governance-forum design — how to stand up an SAP MDG operating model.',
    price: '$49', team: '$79',
    url: 'https://vihrenlabs.gumroad.com/l/qwlgi',
  },
  {
    tag: 'Operator pack',
    name: 'SAP Migration Operator\'s Pack',
    sub: 'The complete SAP S/4HANA migration kit — cutover workbook + playbook ebook + comms templates. The bundle a real cutover needs.',
    price: '$129', team: '$249',
    url: 'https://vihrenlabs.gumroad.com/l/yjebue',
  },
  {
    tag: 'Operator pack',
    name: 'Master Data Operator\'s Pack',
    sub: 'Audit workbook + maturity assessment + governance playbook — the full master-data operating toolkit, bundled.',
    price: '$179', team: '$299',
    url: 'https://vihrenlabs.gumroad.com/l/oocvu',
  },
  {
    tag: 'Excel workbook',
    name: 'Transition Management Workbook',
    sub: 'Offshoring + Shared Services transition toolkit — 18-tab Excel + delivery-execution playbook + SOP + engagement templates.',
    price: '$179', team: '$349',
    url: 'https://vihrenlabs.gumroad.com/l/iivnut',
  },
  {
    tag: 'Comms kit',
    name: 'SAP Cutover Comms Kit',
    sub: 'Pre-cutover, go-live, hypercare and incident announcement templates — the comms templates a real cutover sends. Pay what you want.',
    price: 'Free+', team: '',
    url: 'https://vihrenlabs.gumroad.com/l/dlzxfu',
  },
];
---

<Base
  title="Vihren Labs"
  description="Operator-grade templates and playbooks for the enterprise IT stack. Built by a 15-year enterprise IT operator — SAP, Master Data Management, regulatory compliance, shared services."
>
  <!-- Noise overlay -->
  <div class="noise-overlay" aria-hidden="true"></div>

  <!-- ═══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[90vh] flex flex-col justify-center px-6 overflow-hidden">

    <!-- Radial glow background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full"
           style="background: radial-gradient(ellipse at center, rgba(30,61,89,0.6) 0%, rgba(8,14,20,0) 70%);">
      </div>
      <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[400px] h-[400px] rounded-full opacity-20"
           style="background: radial-gradient(ellipse at center, rgba(230,126,34,0.4) 0%, transparent 70%);">
      </div>
    </div>

    <!-- Grid lines -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]"
         style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 80px 80px;"
         aria-hidden="true">
    </div>

    <div class="relative max-w-6xl mx-auto w-full py-20">
      <!-- Eyebrow -->
      <div class="fade-up fade-up-delay-1 flex items-center gap-3 mb-8">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Vihren Labs</span>
      </div>

      <!-- Value prop eyebrow — tells cold visitors what this IS before the headline -->
      <p class="fade-up fade-up-delay-2 font-mono text-orange text-sm tracking-[0.18em] uppercase mb-4">
        6 product lines · Procurement · Regulatory · SAP · Master Data Management · Transformation · Digital
      </p>

      <!-- Main headline -->
      <h1 class="fade-up fade-up-delay-2 font-black text-5xl sm:text-6xl lg:text-7xl xl:text-8xl leading-[0.95] tracking-tight mb-8 max-w-4xl">
        Built by someone<br />
        <span class="text-white/30">who's sat on</span><br />
        <span style="color: #E67E22;">both sides.</span>
      </h1>

      <!-- Sub -->
      <p class="fade-up fade-up-delay-3 text-white/50 text-lg sm:text-xl leading-relaxed max-w-xl mb-12">
        Operator-grade templates for procurement, SAP migrations, EU regulatory compliance, master data, and shared services transformation.
      </p>

      <!-- CTAs -->
      <div class="fade-up fade-up-delay-3 flex flex-col sm:flex-row gap-4">
        <a
          href="https://vihrenlabs.gumroad.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-[#E67E22]/20 border border-[#E67E22]/40 text-[#E67E22] font-semibold px-8 py-4 rounded-full text-base hover:bg-[#E67E22]/30 transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-[#E67E22] animate-pulse flex-shrink-0"></span>
          13 products live now on Gumroad
        </a>
        <a
          href="/about"
          class="inline-flex items-center justify-center gap-2 border border-white/10 hover:border-white/30 text-white/60 hover:text-white font-medium px-8 py-4 rounded-full text-base transition-colors"
        >
          About Vihren Labs
        </a>
      </div>

      <!-- Author byline pill — authority signal above the fold -->
      <div class="mt-8 inline-flex items-center gap-3 px-4 py-2 bg-navy-light/40 border border-orange/20 rounded-full font-mono text-xs text-grey-light">
        <span class="w-2 h-2 rounded-full bg-orange flex-shrink-0"></span>
        Built by Petko Petkov · 15 years vendor-side (Fortune-100 IT distributor)
      </div>

      <!-- Stats row -->
      <div class="mt-20 pt-10 border-t border-white/5 grid grid-cols-2 sm:grid-cols-4 gap-8">
        {[
          { n: '15+', label: 'Years in enterprise IT' },
          { n: '6', label: 'Product lines' },
          { n: 'SAP', label: 'ECC & S/4HANA' },
          { n: 'EU', label: 'AI Act & DORA' },
        ].map(s => (
          <div>
            <div class="font-black text-3xl text-[#E67E22]">{s.n}</div>
            <div class="text-white/40 text-sm mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TICKER ════════════════════════════════════════════════════════ -->
  <div class="border-y border-white/5 py-4 overflow-hidden bg-[#0F1E2E]" aria-hidden="true">
    <div class="flex whitespace-nowrap">
      <div class="marquee-track flex items-center gap-10">
        {[...ticker, ...ticker].map(item => (
          <span class="font-mono text-xs text-white/30 uppercase tracking-[0.15em] flex items-center gap-10">
            {item}
            <span class="text-[#E67E22] opacity-50">&middot;</span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══ OPERATOR VOICE ════════════════════════════════════════════════ -->
  <section class="py-28 px-6">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-6">What this is</p>
        <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-8">
          Not a framework.<br />
          <span class="text-white/30">Not a methodology.<br /></span>
          The operating detail.
        </h2>
        <span class="font-mono text-xs text-[#E67E22]/60 border border-[#E67E22]/20 px-4 py-2 rounded-full">
          Live now on Gumroad
        </span>
      </div>

      <div class="space-y-4">
        {[
          { num: '01', text: 'Real T-codes, real article numbers, real cutover-night failure modes — not abstractions.' },
          { num: '02', text: 'Built for people who make decisions, not consultants who document them.' },
          { num: '03', text: 'No fluff. No "step one: understand your stakeholders."' },
          { num: '04', text: 'Open on a Monday morning. Usable by Friday.' },
        ].map(item => (
          <div class="flex items-start gap-5 p-5 rounded-xl border border-white/5 bg-white/[0.02] card-hover">
            <span class="font-mono text-xs text-[#E67E22]/50 flex-shrink-0 pt-0.5 tracking-widest">{item.num}</span>
            <p class="text-white/60 text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ PRODUCT LINES ═════════════════════════════════════════════════ -->
  <section class="py-28 px-6 bg-[#0A1520]">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-16 flex-wrap gap-4">
        <div>
          <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">Product lines</p>
          <h2 class="font-black text-4xl sm:text-5xl leading-tight">Five expertise clusters.<br /><span class="text-white/30">One operator's 15 years.</span></h2>
        </div>
        <span class="font-mono text-xs text-white/25 border border-white/8 px-5 py-2.5 rounded-full">
          Live now on Gumroad
        </span>
      </div>

      <div class="space-y-3">
        {lines.map((line, i) => (
          <div class="flex items-start gap-6 sm:gap-8 p-6 sm:p-8 rounded-2xl border border-white/5 bg-white/[0.02]">
            <div class="flex-shrink-0 pt-1">
              <span class="line-number text-white/15">{line.num}</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <h3 class="font-bold text-lg text-white/80">{line.name}</h3>
                <div class="flex flex-wrap gap-2 flex-shrink-0">
                  {line.tags.map(tag => (
                    <span class="font-mono text-[10px] text-white/20 border border-white/8 px-2 py-0.5 rounded tracking-wider uppercase">{tag}</span>
                  ))}
                </div>
              </div>
              <p class="text-white/40 text-sm leading-relaxed mt-2">{line.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ AVAILABLE NOW ═══════════════════════════════════════════════ -->
  <section class="py-24 px-6 border-t border-white/5">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <div>
          <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-3">Available now</p>
          <h2 class="font-black text-3xl sm:text-4xl leading-tight">First products. Live today.</h2>
        </div>
        <a href="https://vihrenlabs.gumroad.com" target="_blank" rel="noopener noreferrer"
           class="font-mono text-xs text-white/30 hover:text-[#E67E22] transition-colors tracking-wider uppercase border border-white/8 px-4 py-2 rounded">
          View all in shop &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

        <!-- T-029 Free manifesto -->
        <a href="https://vihrenlabs.gumroad.com/l/bwzklq" target="_blank" rel="noopener noreferrer"
           class="group flex flex-col border border-white/8 rounded-2xl p-6 hover:border-[#E67E22]/30 transition-colors bg-white/[0.02]">
          <div class="flex items-center gap-2 mb-4">
            <span class="font-mono text-[10px] text-[#E67E22] border border-[#E67E22]/30 bg-[#E67E22]/8 px-2 py-0.5 rounded tracking-wider uppercase">Free PDF</span>
          </div>
          <h3 class="font-bold text-base text-white/80 leading-snug mb-2">The Vihren Labs Operator Standard</h3>
          <p class="text-white/35 text-sm leading-relaxed flex-1">The 7 operating principles behind every template in the catalogue.</p>
          <div class="flex items-center justify-between mt-6">
            <span class="font-black text-xl text-white/90">$0</span>
            <span class="font-mono text-xs text-white/25 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase">Get it &rarr;</span>
          </div>
        </a>

        {products.map(p => (
          <a href={p.url} target="_blank" rel="noopener noreferrer"
             class="group flex flex-col border border-white/8 rounded-2xl p-6 hover:border-[#E67E22]/30 transition-colors bg-white/[0.02]">
            <div class="flex items-center gap-2 mb-4">
              <span class="font-mono text-[10px] text-white/30 border border-white/8 px-2 py-0.5 rounded tracking-wider uppercase">{p.tag}</span>
            </div>
            <h3 class="font-bold text-base text-white/80 leading-snug mb-2">{p.name}</h3>
            <p class="text-white/35 text-sm leading-relaxed flex-1">{p.sub}</p>
            <div class="flex items-center justify-between mt-6">
              <span class="font-black text-xl text-white/90">{p.price}{p.team ? (<span class="text-white/30 text-sm font-normal"> / {p.team}</span>) : null}</span>
              <span class="font-mono text-xs text-white/25 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase">Get it &rarr;</span>
            </div>
          </a>
        ))}

      </div>
    </div>
  </section>

  <!-- ═══ FREE LEAD MAGNET ══════════════════════════════════════════════ -->
  <section class="py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="relative rounded-3xl overflow-hidden border border-white/8 p-10 sm:p-16"
           style="background: linear-gradient(135deg, rgba(30,61,89,0.4) 0%, rgba(8,14,20,0.9) 60%);">
        <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 pointer-events-none"
             style="background: radial-gradient(ellipse at top right, #E67E22, transparent 70%);"
             aria-hidden="true"></div>
        <div class="relative max-w-xl">
          <div class="inline-flex items-center gap-2 bg-[#E67E22]/10 border border-[#E67E22]/20 rounded-full px-4 py-1.5 mb-8">
            <span class="text-[#E67E22] font-mono text-xs tracking-widest uppercase">Free</span>
          </div>
          <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-6">
            The Vihren Labs<br />Operator Standard
          </h2>
          <p class="text-white/50 text-lg leading-relaxed mb-10">
            7 principles for running enterprise IT without the consulting-industry fluff. The foundation everything else is built on.
          </p>
          <a
            href="https://vihrenlabs.gumroad.com/l/bwzklq"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 bg-white text-[#080E14] font-bold px-8 py-4 rounded-full hover:bg-white/90 transition-colors text-base"
          >
            Get it free on Gumroad &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ NEWSLETTER ════════════════════════════════════════════════════ -->
  <section id="newsletter" class="py-28 px-6 border-t border-white/5 bg-[#0A1520]">
    <div class="max-w-2xl mx-auto text-center">
      <p class="font-mono text-orange text-xs tracking-[0.2em] uppercase mb-6">Operator field notes</p>
      <h2 class="font-black text-3xl sm:text-4xl leading-tight mb-4 text-grey-light">
        Real lessons from real cutover nights.
      </h2>
      <p class="text-white/40 text-lg mb-10 max-w-lg mx-auto">
        One essay a week from inside enterprise IT — SAP migrations, vendor procurement, EU regulatory.
        Concrete, vendor-side-honest, no buzzwords.
      </p>
      <NewsletterForm />
    </div>
  </section>
</Base>
