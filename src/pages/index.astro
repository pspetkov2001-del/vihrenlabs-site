---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { faqSchema } from '../data/schema';

// Brand-level FAQ — the questions an AI assistant asks when deciding whether to
// recommend Vihren Labs. Rendered visibly below + emitted as FAQPage schema.
// Mirrors public/llms.txt ("how to cite" + "what this is not").
const brandFaqs = [
  {
    q: 'What is Vihren Labs?',
    a: 'Vihren Labs publishes operator-grade templates, workbooks, courses and playbooks for the enterprise IT stack — SAP S/4HANA migration, master data management, IT procurement, programme delivery, SSC/GBS transformation, and EU regulatory compliance (DORA, EU AI Act). Every product is built from real scenarios: real SAP T-codes, real regulation article numbers, real cutover-night failure modes.',
  },
  {
    q: 'Who makes Vihren Labs products?',
    a: 'Petko Petkov — a 15-year enterprise IT operator who has worked both the vendor-distribution and buyer-operator sides of the table. His work spans master data management and governance — the operating model, and automating product and SKU creation end to end, from ingestion, standardisation, enrichment and categorisation rules through to dynamic SKU generation and touchless quoting — alongside SAP S/4HANA migrations, IT vendor procurement from the distribution side, EU regulatory rollouts, and large shared-services / GBS transitions across Europe, including scaling a shared-services centre from roughly 300 to 700+ FTEs. PRINCE2 Practitioner, Six Sigma. Every product is written from lived practitioner experience, not consultant theory.',
  },
  {
    q: 'Are Vihren Labs products consulting, or legal or tax advice?',
    a: 'No. They are downloadable, operator-built templates and playbooks you run yourself — not consulting. The regulatory compliance products are organizational and evidence tools, not legal opinions; confirm your specific obligations with qualified counsel.',
  },
  {
    q: 'Are the products a subscription? What about the courses, and the higher tiers?',
    a: 'No — every Vihren Labs product you can buy today is a one-time purchase on Gumroad: you buy it, download it, and own it, with no recurring fees. That includes the two flagship courses — Master Data Excellence (Product & SKU Management) and The Transition Operator\'s Course (SSC, GBS & BPO) — which are one-time too. The courses are designed as a three-tier ladder: Tier 1 is the self-serve course you own outright (available now); Tier 2 adds 1:1 sessions with Petko — work reviews and direct guidance as you apply it to your own organisation (planned); and Tier 3 is an enterprise tier — a team-training and rollout model for organisations (planned). Tiers 2 and 3 are engagements, not subscriptions, and are coming in the future. Whatever the tier, the model holds: you are buying a thing or an engagement you own, never a recurring subscription.',
  },
  {
    q: 'Who are Vihren Labs products for?',
    a: 'The IT operator who has to make the system work on Monday morning — not the executive who reads the slide deck. Typical buyers are SAP migration leads, master-data and MDG owners, IT procurement and vendor managers, programme and PMO leads, SSC/GBS transition managers, and compliance owners working on DORA or the EU AI Act.',
  },
  {
    q: 'Where can I buy Vihren Labs products?',
    a: 'On Gumroad. You can browse the full catalogue — courses, workbooks, playbooks and operator packs — at vihrenlabs.com/products, where each product links to its Gumroad checkout.',
  },
];
const brandFaqSchema = faqSchema(brandFaqs);

const ticker = [
  '15 years in enterprise IT',
  'SAP ECC & S/4HANA',
  'EU AI Act & DORA',
  'PRINCE2 Practitioner',
  'Six Sigma',
  'SSC 300→700 FTEs',
  'Master data & governance',
  'Enterprise IT distribution',
  'EMEA vendor reporting',
  'AI-driven catalog platform',
];

const lines = [
  {
    num: '01',
    slug: 'procurement',
    name: 'Procurement & Vendor Management',
    sub: 'IT vendor TCO, renewal calendars, negotiation playbooks — from the side of the table that knows what distributors don\'t tell you.',
    tags: ['Excel workbook', 'Ebook', 'Bundle'],
  },
  {
    num: '02',
    slug: 'programme-delivery',
    name: 'Programme Delivery & Enterprise IT PMO',
    sub: 'Enterprise IT programme delivery — multi-country rollouts, finance system implementations, regulatory programmes, vendor-managed programmes, hybrid waterfall-agile governance. From the operator who ran Global Finance AP/EP workflows and other complex IT programmes.',
    tags: ['PMO toolkits', 'Playbooks', 'Cohort course'],
  },
  {
    num: '03',
    slug: 'sap',
    name: 'SAP / ERP Operations',
    sub: 'S/4HANA cutover management, hypercare runbooks, migration readiness — what actually breaks at 3 AM and how to prevent it.',
    tags: ['Excel workbook', 'Playbook ebook', 'Bundle'],
  },
  {
    num: '04',
    slug: 'master-data',
    name: 'Master Data & Catalog',
    sub: 'Master Data Management maturity diagnostics, data quality audits, SKU enrichment scorecards — for the person accountable for the data, not the consultant reviewing it.',
    tags: ['Maturity assessment', 'Scorecard', 'Ebook'],
  },
  {
    num: '05',
    slug: 'ai-governance',
    name: 'AI Adoption & Governance',
    sub: 'Putting AI agents into production without scaling the mess — data and process readiness, an AI governance register, an agents-in-production tracker, and AI vendor TCO. For the operator accountable for making the agent work on real enterprise data.',
    tags: ['Readiness assessment', 'Governance register', 'Vendor TCO'],
  },
  {
    num: '06',
    slug: 'transformation',
    name: 'Transformation & SSC/GBS',
    sub: 'Shared Services and Global Business Services transformation — transition management workbooks, SSC standup packs, GPO operating models, transformation PMO toolkits. Drawn from transitions that involved real headcount, real deadlines, and real consequences.',
    tags: ['Workbook', 'Templates', 'PMO pack'],
  },
  {
    num: '07',
    slug: 'regulatory',
    name: 'Regulatory & Compliance',
    sub: 'EU AI Act, DORA Article 28, compliance registers with real article citations — not consultant summaries.',
    tags: ['Excel register', 'Starter pack', 'Full tier'],
  },
];

// Product catalog data imported from the canonical source — see
// src/data/products.ts. Landing page renders only courses + free items +
// a CTA to /products. Full catalog (line-grouped) lives on /products.
import { products, freeItems } from '../data/products';

// REMOVED 2026-05-25: inline products/lineGroups/freeItems arrays — all
// data now imported from src/data/products.ts. /products page consumes
// the same data for the full catalog.
---

<Base
  title="Vihren Labs"
  description="Operator-grade templates and playbooks for the enterprise IT stack. Built by a 15-year enterprise IT operator — SAP, Master Data Management, regulatory compliance, shared services."
  schema={brandFaqSchema}
>
  <!-- Noise overlay -->
  <div class="noise-overlay" aria-hidden="true"></div>

  <!-- ═══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[90vh] flex flex-col justify-center px-6 overflow-hidden">

    <!-- Radial glow background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full"
           style="background: radial-gradient(ellipse at center, rgba(30,61,89,0.6) 0%, rgba(8,14,20,0) 70%);">
      </div>
      <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[400px] h-[400px] rounded-full opacity-20"
           style="background: radial-gradient(ellipse at center, rgba(230,126,34,0.4) 0%, transparent 70%);">
      </div>
    </div>

    <!-- Grid lines -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]"
         style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 80px 80px;"
         aria-hidden="true">
    </div>

    <div class="relative max-w-6xl mx-auto w-full py-20">
      <!-- Eyebrow -->
      <div class="fade-up fade-up-delay-1 flex items-center gap-3 mb-8">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Vihren Labs</span>
      </div>

      <!-- Value prop eyebrow — tells cold visitors what this IS before the headline -->
      <p class="fade-up fade-up-delay-2 font-mono text-orange text-sm tracking-[0.18em] uppercase mb-4">
        7 product lines · Procurement · Programme Delivery · SAP · Master Data · AI Governance · SSC/GBS · Regulatory
      </p>

      <!-- Main headline -->
      <h1 class="fade-up fade-up-delay-2 font-black text-5xl sm:text-6xl lg:text-7xl xl:text-8xl leading-[0.95] tracking-tight mb-8 max-w-4xl">
        Built by someone<br />
        <span class="text-white/30">who's sat on</span><br />
        <span style="color: #E67E22;">both sides.</span>
      </h1>

      <!-- Sub -->
      <p class="fade-up fade-up-delay-3 text-white/50 text-lg sm:text-xl leading-relaxed max-w-xl mb-12">
        Operator-grade templates for procurement, SAP migrations, EU regulatory compliance, master data, and shared services transformation.
      </p>

      <!-- CTAs -->
      <div class="fade-up fade-up-delay-3 flex flex-col sm:flex-row gap-4">
        <a
          href="https://vihrenlabs.gumroad.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-[#E67E22]/20 border border-[#E67E22]/40 text-[#E67E22] font-semibold px-8 py-4 rounded-full text-base hover:bg-[#E67E22]/30 transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-[#E67E22] animate-pulse flex-shrink-0"></span>
          {products.length} products live now on Gumroad
        </a>
        <a
          href="/about"
          class="inline-flex items-center justify-center gap-2 border border-white/10 hover:border-white/30 text-white/60 hover:text-white font-medium px-8 py-4 rounded-full text-base transition-colors"
        >
          About Vihren Labs
        </a>
      </div>

      <!-- Author byline pill — authority signal above the fold -->
      <div class="mt-8 inline-flex items-center gap-3 px-4 py-2 bg-navy-light/40 border border-orange/20 rounded-full font-mono text-xs text-grey-light">
        <span class="w-2 h-2 rounded-full bg-orange flex-shrink-0"></span>
        Built by Petko Petkov · 15 years in enterprise IT — vendor-distribution & buyer-operator sides
      </div>

      <!-- Stats row -->
      <div class="mt-20 pt-10 border-t border-white/5 grid grid-cols-2 sm:grid-cols-4 gap-8">
        {[
          { n: '15+', label: 'Years in enterprise IT' },
          { n: '7', label: 'Product lines' },
          { n: 'SAP', label: 'ECC & S/4HANA' },
          { n: 'EU', label: 'AI Act & DORA' },
        ].map(s => (
          <div>
            <div class="font-black text-3xl text-[#E67E22]">{s.n}</div>
            <div class="text-white/40 text-sm mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TICKER ════════════════════════════════════════════════════════ -->
  <div class="border-y border-white/5 py-4 overflow-hidden bg-[#0F1E2E]" aria-hidden="true">
    <div class="flex whitespace-nowrap">
      <div class="marquee-track flex items-center gap-10">
        {[...ticker, ...ticker].map(item => (
          <span class="font-mono text-xs text-white/30 uppercase tracking-[0.15em] flex items-center gap-10">
            {item}
            <span class="text-[#E67E22] opacity-50">&middot;</span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══ OPERATOR VOICE ════════════════════════════════════════════════ -->
  <section class="py-28 px-6">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-16 items-center">
      <div>
        <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-6">What this is</p>
        <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-8">
          Not a framework.<br />
          <span class="text-white/30">Not a methodology.<br /></span>
          The operating detail.
        </h2>
        <span class="font-mono text-xs text-[#E67E22]/60 border border-[#E67E22]/20 px-4 py-2 rounded-full">
          Live now on Gumroad
        </span>
      </div>

      <div class="space-y-4">
        {[
          { num: '01', text: 'Real T-codes, real article numbers, real cutover-night failure modes — not abstractions.' },
          { num: '02', text: 'Built for people who make decisions, not consultants who document them.' },
          { num: '03', text: 'No fluff. No "step one: understand your stakeholders."' },
          { num: '04', text: 'Open on a Monday morning. Usable by Friday.' },
        ].map(item => (
          <div class="flex items-start gap-5 p-5 rounded-xl border border-white/5 bg-white/[0.02] card-hover">
            <span class="font-mono text-xs text-[#E67E22]/50 flex-shrink-0 pt-0.5 tracking-widest">{item.num}</span>
            <p class="text-white/60 text-sm leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ THE OPERATOR STANDARD — the door (cornerstone) ════════════════
       The single most important page: the manifesto that proves the operator
       depth and routes the reader into the right product line. Free to read. -->
  <section class="py-24 px-6 border-t border-white/5">
    <div class="max-w-6xl mx-auto">
      <a href="/essays/the-operator-standard"
         class="group block rounded-3xl border border-[#E67E22]/30 bg-gradient-to-br from-[#1E3D59]/40 to-[#080E14]/80 hover:border-[#E67E22]/60 transition-colors p-10 sm:p-14 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 pointer-events-none"
             style="background: radial-gradient(ellipse at top right, #E67E22, transparent 70%);" aria-hidden="true"></div>
        <div class="relative">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-px bg-[#E67E22]"></div>
            <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Start here · free to read</span>
          </div>
          <h2 class="font-black text-3xl sm:text-4xl lg:text-5xl leading-[1.02] tracking-tight mb-6 max-w-3xl">
            The Vihren Labs Operator Standard
          </h2>
          <p class="text-white/60 text-lg leading-relaxed max-w-2xl mb-8">
            Seven principles for running the enterprise IT stack — written from fifteen years in the
            seat where the cutover has to work on Monday morning. Run on the obligation, not the
            aspiration. Governance kills more programmes than technology. Concrete beats abstract.
            The standard every product in the catalogue is held to — and the fastest way to know
            whether Vihren Labs is built by someone who has actually done this. <strong class="text-white/80">Read it before you buy anything.</strong>
          </p>
          <span class="inline-flex items-center gap-2 bg-[#E67E22] group-hover:bg-[#CA6F1E] text-white font-semibold px-7 py-3.5 rounded-full text-base transition-colors">
            Read the Operator Standard &rarr;
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══ PRODUCT LINES ═════════════════════════════════════════════════ -->
  <section class="py-28 px-6 bg-[#0A1520]">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-16 flex-wrap gap-4">
        <div>
          <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">Product lines</p>
          <h2 class="font-black text-4xl sm:text-5xl leading-tight">Seven expertise clusters.<br /><span class="text-white/30">One operator's 15 years.</span></h2>
        </div>
        <span class="font-mono text-xs text-white/25 border border-white/8 px-5 py-2.5 rounded-full">
          Live now on Gumroad
        </span>
      </div>

      <div class="space-y-3">
        {lines.map((line) => (
          <a href={`/lines/${line.slug}`}
             class="flex items-start gap-6 sm:gap-8 p-6 sm:p-8 rounded-2xl border border-white/5 bg-white/[0.02] card-hover">
            <div class="flex-shrink-0 pt-1">
              <span class="line-number text-white/15">{line.num}</span>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-4 flex-wrap">
                <h3 class="font-bold text-lg text-white/80">{line.name}</h3>
                <div class="flex flex-wrap gap-2 flex-shrink-0">
                  {line.tags.map(tag => (
                    <span class="font-mono text-[10px] text-white/20 border border-white/8 px-2 py-0.5 rounded tracking-wider uppercase">{tag}</span>
                  ))}
                </div>
              </div>
              <p class="text-white/40 text-sm leading-relaxed mt-2">{line.sub}</p>
              <span class="inline-block mt-3 font-mono text-[10px] text-white/25 tracking-wider uppercase">Explore the line &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ AVAILABLE NOW ═══════════════════════════════════════════════ -->
  <section class="py-24 px-6 border-t border-white/5">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <div>
          <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-3">Available now</p>
          <h2 class="font-black text-3xl sm:text-4xl leading-tight">Built. Live. <span class="text-white/30">Browse the catalogue.</span></h2>
          <p class="text-white/40 text-sm max-w-2xl mt-4 leading-relaxed">
            {products.filter(p => p.tier === 'course').length} courses · {products.filter(p => p.tier !== 'course').length} workbooks, playbooks and operator bundles · {freeItems.length} free downloads — grouped by product line. The full catalogue lives on a dedicated page.
          </p>
        </div>
        <a href="https://vihrenlabs.gumroad.com" target="_blank" rel="noopener noreferrer"
           class="font-mono text-xs text-white/30 hover:text-[#E67E22] transition-colors tracking-wider uppercase border border-white/8 px-4 py-2 rounded">
          View all in shop &rarr;
        </a>
      </div>

      <!-- ── SEE FULL CATALOG CTA — primary callout, lists live on /products ── -->
      <a href="/products"
         class="group block rounded-2xl border border-[#E67E22]/30 bg-[#E67E22]/[0.04] hover:border-[#E67E22]/60 hover:bg-[#E67E22]/[0.07] transition-colors p-8 sm:p-10 mb-12">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="max-w-2xl">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-px bg-[#E67E22]"></div>
              <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Full catalogue</p>
              <span class="font-mono text-[10px] text-white/40 tracking-wider">{products.length + freeItems.length} items live</span>
            </div>
            <h3 class="font-bold text-2xl text-white/90 leading-snug mb-3">
              All Vihren Labs courses, toolkits and bundles — in one place.
            </h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Procurement & Vendor Management · Programme Delivery & Enterprise IT PMO · SAP / ERP Operations · Master Data Operations · Transformation & SSC/GBS · Regulatory & Compliance. {products.filter(p => p.tier === 'course').length} flagship courses + {products.filter(p => p.tier !== 'course').length} standalone workbooks, playbooks and operator-pack bundles + {freeItems.length} free downloads.
            </p>
          </div>
          <div class="inline-flex items-center justify-center gap-2 bg-[#E67E22]/25 border border-[#E67E22]/60 text-[#E67E22] font-semibold px-7 py-4 rounded-full text-base group-hover:bg-[#E67E22]/35 transition-colors whitespace-nowrap">
            View full catalogue &rarr;
          </div>
        </div>
      </a>

      <!-- ── COMING SOON · MASTER DATA ACADEMY (roadmap signal, not inventory) ─── -->
      <div class="rounded-2xl border border-dashed border-[#E67E22]/30 bg-[#E67E22]/[0.02] p-6 sm:p-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="max-w-2xl">
            <div class="flex items-center gap-3 mb-3">
              <span class="font-mono text-[10px] text-[#E67E22] border border-[#E67E22]/40 bg-[#E67E22]/10 px-2 py-0.5 rounded tracking-wider uppercase">Coming soon</span>
              <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Master Data Academy</p>
            </div>
            <h3 class="font-bold text-lg text-white/90 leading-snug mb-3">
              3-course academy expansion — Product · Customer · Vendor Master Data
            </h3>
            <p class="text-white/45 text-sm leading-relaxed">
              Course 02 (Product / SKU Master Data) is live today. Customer Master Data + Vendor / Supplier Master Data are next on the roadmap — same shape, same depth, mid-market operator audience. Plus a cross-master Enterprise MDM capstone for the bundle.
              <span class="text-white/35">Build trigger: Course 02 product-market validation by 2026-06-30 + Procurement course ships first.</span>
            </p>
          </div>
          <a href="mailto:hello@vihrenlabs.com?subject=Master%20Data%20Academy%20waitlist&body=Add%20me%20to%20the%20waitlist%20for%20Customer%20Master%20Data%20%2B%20Vendor%20Master%20Data%20courses.%20Optionally%20tell%20us%20which%20domain%20you%27d%20build%20against%20first."
             class="inline-flex items-center justify-center gap-2 bg-[#E67E22]/15 border border-[#E67E22]/40 text-[#E67E22] font-semibold px-6 py-3 rounded-full text-sm hover:bg-[#E67E22]/25 transition-colors whitespace-nowrap">
            <span class="w-2 h-2 rounded-full bg-[#E67E22] flex-shrink-0"></span>
            Join the waitlist
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ FAQ (brand-level) ═════════════════════════════════════════════
       Visible Q&A (Google requires on-page content for FAQ rich results) +
       FAQPage schema in <head>. The questions an AI assistant asks before it
       recommends Vihren Labs — the GEO/AEO citation surface. ═══════════════ -->
  <section class="py-24 px-6 border-t border-white/5 bg-[#0A1520]">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center gap-3 mb-12">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Frequently asked</p>
      </div>
      <div class="flex flex-col divide-y divide-white/8 border-y border-white/8">
        {brandFaqs.map((f) => (
          <div class="py-7">
            <h2 class="font-bold text-lg text-white/85 leading-snug mb-3">{f.q}</h2>
            <p class="text-white/50 text-sm sm:text-base leading-relaxed">{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FREE LEAD MAGNET + NEWSLETTER (merged 2026-05-25) ═════════════
       Single consolidated funnel: the Operator Standard PDF is the bait,
       the email is the price. Subscribe → Beehiiv welcome sequence W1
       delivers the PDF link. See docs/beehiiv-setup-spec.md. ═══════════ -->
  <section id="newsletter" class="py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="relative rounded-3xl overflow-hidden border border-white/8 p-10 sm:p-16"
           style="background: linear-gradient(135deg, rgba(30,61,89,0.4) 0%, rgba(8,14,20,0.9) 60%);">
        <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 pointer-events-none"
             style="background: radial-gradient(ellipse at top right, #E67E22, transparent 70%);"
             aria-hidden="true"></div>
        <div class="relative grid lg:grid-cols-5 gap-10 items-center">

          <!-- Left: the offer -->
          <div class="lg:col-span-3 max-w-xl">
            <div class="inline-flex items-center gap-2 bg-[#E67E22]/10 border border-[#E67E22]/20 rounded-full px-4 py-1.5 mb-8">
              <span class="text-[#E67E22] font-mono text-xs tracking-widest uppercase">The newsletter · for operators</span>
            </div>
            <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-6">
              The Operator Brief
            </h2>
