---
import Base from '../layouts/Base.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { faqSchema } from '../data/schema';

// Brand-level FAQ — the questions an AI assistant asks when deciding whether to
// recommend Vihren Labs. Rendered visibly below + emitted as FAQPage schema.
// Mirrors public/llms.txt ("how to cite" + "what this is not").
const brandFaqs = [
  {
    q: 'What is Vihren Labs?',
    a: 'Vihren Labs publishes operator-grade templates, workbooks, courses and playbooks for the enterprise IT stack - SAP S/4HANA migration, master data management, IT procurement, programme delivery, SSC/GBS transformation, and EU regulatory compliance (DORA, EU AI Act). Every product is built from real scenarios: real SAP T-codes, real regulation article numbers, real cutover-night failure modes.',
  },
  {
    q: 'Who makes Vihren Labs products?',
    a: 'Petko Petkov - a 15-year enterprise IT operator who has worked both the vendor-distribution and buyer-operator sides of the table. His work spans master data management and governance - the operating model, and automating product and SKU creation end to end, from ingestion, standardisation, enrichment and categorisation rules through to dynamic SKU generation and touchless quoting - alongside SAP S/4HANA migrations, IT vendor procurement from the distribution side, EU regulatory rollouts, and large shared-services / GBS transitions across Europe. PRINCE2 Practitioner, Six Sigma. Every product is written from lived practitioner experience, not consultant theory.',
  },
  {
    q: 'Are Vihren Labs products consulting, or legal or tax advice?',
    a: 'No. They are downloadable, operator-built templates and playbooks you run yourself - not consulting. The regulatory compliance products are organizational and evidence tools, not legal opinions; confirm your specific obligations with qualified counsel.',
  },
  {
    q: 'What courses does Vihren Labs offer?',
    a: 'Four operator courses, all live and one-time purchases. The Master Data Academy is a three-course set - Master Data Excellence for Product & SKU Management, for Customer & Business Partner, and for Vendor & Supplier Master - each 10 modules with workbooks, operator templates and a capstone you build against your own organization. Alongside them is The Transition Operator\'s Course for SSC, GBS and BPO transitions. Each course also anchors a value ladder of standalone workbooks and operator packs in the same line.',
  },
  {
    q: 'Are the products a subscription? What about the courses, and the higher tiers?',
    a: 'No - every Vihren Labs product you can buy today is a one-time purchase on Gumroad: you buy it, download it, and own it, with no recurring fees. That includes all four courses - the three-course Master Data Academy (Product & SKU, Customer & Business Partner, and Vendor & Supplier Master) and The Transition Operator\'s Course (SSC, GBS & BPO) - which are one-time too. The courses are designed as a three-tier ladder: Tier 1 is the self-serve course you own outright (available now); Tier 2 adds 1:1 sessions with Petko - work reviews and direct guidance as you apply it to your own organisation (planned); and Tier 3 is an enterprise tier - a team-training and rollout model for organisations (planned). Tiers 2 and 3 are engagements, not subscriptions, and are coming in the future. Whatever the tier, the model holds: you are buying a thing or an engagement you own, never a recurring subscription.',
  },
  {
    q: 'Who are Vihren Labs products for?',
    a: 'The IT operator who has to make the system work on Monday morning - not the executive who reads the slide deck. Typical buyers are SAP migration leads, master-data and MDG owners, IT procurement and vendor managers, programme and PMO leads, SSC/GBS transition managers, and compliance owners working on DORA or the EU AI Act.',
  },
  {
    q: 'Where can I buy Vihren Labs products?',
    a: 'On Gumroad. You can browse the full catalogue - courses, workbooks, playbooks and operator packs - at vihrenlabs.com/products, where each product links to its Gumroad checkout.',
  },
];
const brandFaqSchema = faqSchema(brandFaqs);

const ticker = [
  '15 years in enterprise IT',
  'SAP ECC & S/4HANA',
  'EU AI Act & DORA',
  'PRINCE2 Practitioner',
  'Six Sigma',
  'Multi-country SSC build-outs',
  'Master data & governance',
  'Enterprise IT operations',
  'EMEA vendor reporting',
  'Catalog automation & governance',
];

// Product catalog data imported from the canonical source — see
// src/data/products.ts. Landing page renders only courses + free items +
// a CTA to /products. Full catalog (line-grouped) lives on /products.
import { products, freeItems, lineGroups } from '../data/products';

// This page no longer states a product-line COUNT anywhere. The three places
// that did (hero eyebrow, hero stat, catalogue headline) drifted to "7" after
// the programme-delivery fold on 2026-07-22 and had to be chased down one at a
// time; deriving the count from lineGroups.length fixed that. D-060 (2026-07-26)
// made the derivation unnecessary: the front door now names the two categories
// it leads with rather than counting lines, so there is no number left to drift.
// If a line count ever returns to this page, derive it - never hard-code it.

// Credential chips for the landing bio block. A tighter subset of the /about
// list — the language and legal-entity chips stay on /about so this section
// reads compact.
const credentials = [
  '15 years in enterprise IT',
  'Both sides: vendor-distribution & buyer-operator',
  'Master data transformation & governance',
  'PRINCE2 Practitioner',
  'Six Sigma',
  'Sofia, Bulgaria',
];

// REMOVED 2026-05-25: inline products/lineGroups/freeItems arrays — all
// data now imported from src/data/products.ts. /products page consumes
// the same data for the full catalog.
---

<Base
  title="Vihren Labs"
  description="Operator-grade templates and playbooks for the enterprise IT stack. Built by a 15-year enterprise IT operator - SAP, Master Data Management, AI governance, regulatory compliance, shared services."
  schema={brandFaqSchema}
>
  <!-- Noise overlay -->
  <div class="noise-overlay" aria-hidden="true"></div>

  <!-- ═══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative min-h-[90vh] flex flex-col justify-center px-6 overflow-hidden blueprint-pattern">

    <!-- Radial glow background -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[600px] rounded-full"
           style="background: radial-gradient(ellipse at center, rgba(30, 61, 89,0.6) 0%, rgba(8, 14, 20,0) 70%);">
      </div>
      <div class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[400px] h-[400px] rounded-full opacity-20"
           style="background: radial-gradient(ellipse at center, rgba(30, 61, 89,0.4) 0%, transparent 70%);">
      </div>
    </div>

    <!-- Grid lines -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.03]"
         style="background-image: linear-gradient(rgba(255,255,255,0.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.5) 1px, transparent 1px); background-size: 80px 80px;"
         aria-hidden="true">
    </div>

    <div class="relative max-w-6xl mx-auto w-full py-20">
      <!-- Eyebrow -->
      <div class="fade-up fade-up-delay-1 flex items-center gap-3 mb-8">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Vihren Labs</span>
      </div>

      <!-- Value prop eyebrow — tells cold visitors what this IS before the headline -->
      <p class="fade-up fade-up-delay-2 font-mono text-[#E67E22] text-sm tracking-[0.18em] uppercase mb-4">
        Master Data Operations · AI-Ready Operations
      </p>

      <!-- Main headline -->
      <h1 class="fade-up fade-up-delay-2 font-black text-5xl sm:text-6xl lg:text-7xl xl:text-8xl leading-[0.95] tracking-tight mb-8 max-w-4xl">
        Built by someone<br />
        <span class="text-white/30">who's sat on</span><br />
        <span style="color: #E67E22;">both sides.</span>
      </h1>

      <!-- Sub -->
      <p class="fade-up fade-up-delay-3 text-white/50 text-lg sm:text-xl leading-relaxed max-w-2xl mb-12">
        For the operator who's accountable when it has to work on Monday morning - the cutover, the renewal, the migration, the AI agent. Operator-grade templates and playbooks for the enterprise IT stack, built from real scenarios, not consultant theory.
      </p>

      <!-- CTAs -->
      <div class="fade-up fade-up-delay-3 flex flex-col sm:flex-row gap-4">
        <a
          href="https://vihrenlabs.gumroad.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 bg-[#E67E22]/20 border border-[#E67E22]/40 text-[#E67E22] font-mono text-xs font-bold uppercase tracking-widest px-8 py-4 rounded-lg hover:bg-[#E67E22]/30 transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-[#E67E22] animate-pulse flex-shrink-0"></span>
          {products.length} products live now on Gumroad
        </a>
        <a
          href="/products"
          class="inline-flex items-center justify-center gap-2 border border-white/10 hover:border-white/30 text-white/60 hover:text-white font-mono text-xs uppercase tracking-widest px-8 py-4 rounded-lg transition-colors"
        >
          Start here
        </a>
      </div>

      <!-- Author byline pill — authority signal above the fold -->
      <div class="mt-8 inline-flex items-center gap-3 px-4 py-2 bg-[#1E3D59]/40 border border-[#E67E22]/20 rounded-full font-mono text-xs text-white/70">
        <span class="w-2 h-2 rounded-full bg-[#E67E22] flex-shrink-0"></span>
        Built by Petko Petkov · 15 years in enterprise IT - vendor-distribution & buyer-operator sides
      </div>

      <!-- Stats row -->
      <div class="mt-20 pt-10 border-t border-white/5 flex flex-wrap gap-16">
        {[
          { n: '15', label: 'Years in enterprise IT' },
          { n: '2', label: 'Core categories' },
        ].map(s => (
          <div>
            <div class="font-black text-3xl text-[#E67E22]">{s.n}</div>
            <div class="text-white/40 text-sm mt-1">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ TICKER ════════════════════════════════════════════════════════ -->
  <div class="border-y border-white/5 py-4 overflow-hidden bg-[#0F1E2E]" aria-hidden="true">
    <div class="flex whitespace-nowrap">
      <div class="marquee-track flex items-center gap-10">
        {[...ticker, ...ticker].map(item => (
          <span class="font-mono text-xs text-white/30 uppercase tracking-[0.15em] flex items-center gap-10">
            {item}
            <span class="text-[#E67E22] opacity-50">&middot;</span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ═══ WHO'S BEHIND THIS — the operator bio ══════════════════════════
       Replaced the former "Why this exists / Who it's for / The problems I
       want to solve" sprawl (2026-07-22, founder request: shorter landing,
       more bio). The bio carries the same credibility in a fraction of the
       length and puts a real face above the value ladder. The audience list
       survives as one line instead of eight chips. Clean-room per the OBA
       posture — no employer or client names. ═══════════════════════════ -->
  <section class="py-24 px-6 border-t border-white/5">
    <div class="max-w-5xl mx-auto grid lg:grid-cols-[auto_1fr] gap-12 lg:gap-16 items-center">
      <!-- Founder photo — natural headshot, not the brand avatar -->
      <div class="flex justify-center lg:justify-start">
        <div class="w-40 h-40 sm:w-52 sm:h-52 rounded-full overflow-hidden flex-shrink-0"
             style="border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 24px 64px -18px rgba(0,0,0,0.65);">
          <img
            src="/petko-photo.webp"
            alt="Petko Petkov, founder of Vihren Labs"
            width="640"
            height="640"
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
      </div>

      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-px bg-[#E67E22]"></div>
          <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Who's behind this</span>
        </div>
        <h2 class="font-black text-3xl sm:text-4xl lg:text-5xl leading-[1.05] tracking-tight mb-6">
          Enterprise IT is written by everyone <span class="text-white/30">except the person it lands on.</span>
        </h2>
        <div class="space-y-4 text-white/60 text-base sm:text-lg leading-relaxed max-w-2xl">
          <p>
            I'm Petko Petkov. Fifteen years inside enterprise IT - and on both sides of every deal. I've run SSC/GBS transitions across multiple European countries, run finance workflows when SOX was teeth-on-the-floor, and sat on the vendor-distribution side of EMEA reporting across the world's largest hardware and software vendors.
          </p>
          <p>
            More recently I've led enterprise master-data transformation - turning manual product and SKU creation into an automated, rules-based, governed pipeline. <strong class="text-white/85">Vihren Labs is the catalogue I wish I'd had in that seat:</strong> fifteen years of pattern-recognition turned into tools an operator can open on Monday and use by Friday.
          </p>
        </div>

        <div class="flex flex-wrap gap-2 mt-8">
          {credentials.map(c => (
            <span class="font-mono text-xs text-white/35 border border-white/10 px-3 py-1.5 rounded-full">{c}</span>
          ))}
        </div>

        <p class="text-white/40 text-sm leading-relaxed mt-8 max-w-2xl">
          I write for the people whose name is on the decision when it goes wrong - SAP and cutover leads, master-data owners, programme and PMO leads, procurement and vendor managers, and DORA / EU AI Act compliance owners. <a href="/about" class="text-[#E67E22] hover:underline font-medium">More about me</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ THE OPERATOR STANDARD — the door (cornerstone) ════════════════
       The single most important page: the manifesto that proves the operator
       depth and routes the reader into the right product line. Free to read. -->
  <section class="py-24 px-6 border-t border-white/5">
    <div class="max-w-6xl mx-auto">
      <a href="/essays/the-operator-standard"
         class="group block rounded-3xl border border-[#E67E22]/30 bg-gradient-to-br from-[#1E3D59]/40 to-[#080E14]/80 hover:border-[#E67E22]/60 transition-colors p-10 sm:p-14 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 pointer-events-none"
             style="background: radial-gradient(ellipse at top right, #E67E22, transparent 70%);" aria-hidden="true"></div>
        <div class="relative">
          <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-px bg-[#E67E22]"></div>
            <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Start here · free to read</span>
          </div>
          <h2 class="font-black text-3xl sm:text-4xl lg:text-5xl leading-[1.02] tracking-tight mb-6 max-w-3xl">
            The Vihren Labs Operator Standard
          </h2>
          <p class="text-white/60 text-lg leading-relaxed max-w-2xl mb-8">
            Seven principles for running the enterprise IT stack - written from fifteen years in the
            seat where the cutover has to work on Monday morning. Run on the obligation, not the
            aspiration. Governance kills more programmes than technology. Concrete beats abstract.
            The standard every product in the catalogue is held to - and the fastest way to know
            whether Vihren Labs is built by someone who has actually done this. <strong class="text-white/80">Read it before you buy anything.</strong>
          </p>
          <span class="inline-flex items-center gap-2 bg-[#E67E22] group-hover:bg-[#CA6F1E] text-white font-mono text-sm font-bold uppercase tracking-widest px-7 py-3.5 rounded-lg transition-colors">
            Read the Operator Standard
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- ═══ THE CATALOGUE (Product Lines + Available Now merged 2026-07-11) ══
       Was two sections — a line card grid and an Available-now block with two
       stacked orange banners. Condensed: the six lines now live on /products
       (/paths was merged into it 2026-07-22), so this is one routing block,
       one catalogue banner (Master Data Academy woven in as the live highlight),
       and light /paths + /cheat-sheets pointers. ════════════════════════════ -->
  <section class="py-28 px-6 border-t border-white/5">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-end justify-between mb-12 flex-wrap gap-4">
        <div>
          <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">The catalogue</p>
          <h2 class="font-black text-4xl sm:text-5xl leading-tight">Two categories I'm known for.<br /><span class="text-white/30">One operator's 15 years.</span></h2>
          <p class="text-white/40 text-sm max-w-2xl mt-5 leading-relaxed">
            {products.filter(p => p.tier === 'course').length} courses · {products.filter(p => p.tier !== 'course').length} workbooks, playbooks and operator bundles · {freeItems.length} free downloads - grouped by product line on a dedicated page.
          </p>
        </div>
        <a href="https://vihrenlabs.gumroad.com" target="_blank" rel="noopener noreferrer"
           class="font-mono text-xs text-white/30 hover:text-[#E67E22] transition-colors tracking-wider uppercase border border-white/8 px-4 py-2 rounded">
          View all in shop
        </a>
      </div>

      <!-- ── One catalogue banner — full catalogue, Master Data Academy woven in ── -->
      <a href="/products"
         class="group block rounded-2xl border border-[#E67E22]/30 bg-[#E67E22]/[0.04] hover:border-[#E67E22]/60 hover:bg-[#E67E22]/[0.07] transition-colors p-8 sm:p-10">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          <div class="max-w-2xl">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-8 h-px bg-[#E67E22]"></div>
              <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Full catalogue</p>
              <span class="font-mono text-[10px] text-white/40 tracking-wider">{products.length + freeItems.length} items live</span>
            </div>
            <h3 class="font-bold text-2xl text-white/90 leading-snug mb-3">
              All courses, toolkits and bundles in one place.
            </h3>
            <p class="text-white/50 text-sm leading-relaxed">
              Master Data Operations · AI Adoption & Governance. Plus operator toolkits for SAP / ERP cutovers, procurement and vendor management, transformation and SSC/GBS, and EU regulatory compliance. {products.filter(p => p.tier === 'course').length} flagship courses + {products.filter(p => p.tier !== 'course').length} standalone workbooks, playbooks and operator-pack bundles + {freeItems.length} free downloads. <strong class="text-white/80">Both front doors are live: the 3-course Master Data Academy - Product · Customer · Vendor - and the AI Adoption & Governance Operator's Pack, five products in one operator system.</strong>
            </p>
          </div>
          <div class="inline-flex items-center justify-center gap-2 bg-[#E67E22]/25 border border-[#E67E22]/60 text-[#E67E22] font-mono text-sm font-bold uppercase tracking-widest px-7 py-4 rounded-lg group-hover:bg-[#E67E22]/35 transition-colors whitespace-nowrap">
            View full catalogue
          </div>
        </div>
      </a>

      <!-- ── Light pointer — free cheat sheets. The "find your path" pointer was
           dropped 2026-07-22: /paths merged into /products, which the "View full
           catalogue" button directly above already links to. ── -->
      <div class="flex flex-wrap items-center gap-x-8 gap-y-3 mt-8">
        <a href="/cheat-sheets" class="inline-flex items-center gap-2 font-mono text-xs text-white/50 hover:text-[#E67E22] tracking-wider uppercase transition-colors">
          <span class="w-1.5 h-1.5 rounded-full bg-[#E67E22] flex-shrink-0"></span>
          Free: the AI-Ready Operations cheat sheets
        </a>
      </div>

    </div>
  </section>

  <!-- ═══ FAQ (brand-level) ═════════════════════════════════════════════
       Visible Q&A (Google requires on-page content for FAQ rich results) +
       FAQPage schema in <head>. The questions an AI assistant asks before it
       recommends Vihren Labs — the GEO/AEO citation surface. ═══════════════ -->
  <section class="py-24 px-6 border-t border-white/5 bg-[#0A1520]">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center gap-3 mb-12">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Frequently asked</p>
      </div>
      <div class="flex flex-col divide-y divide-white/8 border-y border-white/8">
        {brandFaqs.map((f) => (
          <details class="group">
            <summary class="flex items-start justify-between gap-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden py-6">
              <h2 class="font-bold text-base sm:text-lg text-white/85 leading-snug">{f.q}</h2>
              <span
                class="faq-plus text-[#E67E22] font-mono text-xl leading-none mt-0.5 flex-shrink-0"
                aria-hidden="true"
              >+</span>
            </summary>
            <p class="text-white/50 text-sm sm:text-base leading-relaxed pb-7 max-w-2xl">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ FREE LEAD MAGNET + NEWSLETTER (merged 2026-05-25) ═════════════
       Single consolidated funnel: the Operator Standard PDF is the bait,
       the email is the price. Subscribe → Beehiiv welcome sequence W1
       delivers the PDF link. See docs/beehiiv-setup-spec.md. ═══════════ -->
  <section id="newsletter" class="py-28 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="relative rounded-3xl overflow-hidden border border-white/8 p-10 sm:p-16"
           style="background: linear-gradient(135deg, rgba(30, 61, 89,0.4) 0%, rgba(8, 14, 20,0.9) 60%);">
        <div class="absolute top-0 right-0 w-96 h-96 rounded-full opacity-10 pointer-events-none"
             style="background: radial-gradient(ellipse at top right, #E67E22, transparent 70%);"
             aria-hidden="true"></div>
        <div class="relative grid lg:grid-cols-5 gap-10 items-center">

          <!-- Left: the offer -->
          <div class="lg:col-span-3 max-w-xl">
            <div class="inline-flex items-center gap-2 bg-[#E67E22]/10 border border-[#E67E22]/20 rounded-full px-4 py-1.5 mb-8">
              <span class="text-[#E67E22] font-mono text-xs tracking-widest uppercase">The newsletter · for operators</span>
            </div>
            <h2 class="font-black text-4xl sm:text-5xl leading-tight mb-6">
              The Operator Brief
            </h2>
            <p class="text-white/55 text-lg leading-relaxed mb-4">
              One essay a week from inside enterprise IT - SAP migrations, vendor procurement, EU regulatory, master data. Vendor-side-honest, no buzzwords.
            </p>
            <p class="text-white/40 text-base leading-relaxed">
              New here? Start with the free <a href="/essays/the-operator-standard" class="text-[#E67E22] hover:underline font-medium">Operator Standard</a> - the seven principles every product is held to. Read it on-site, no email required; subscribe when you want the weekly brief.
            </p>
          </div>

          <!-- Right: the signup form -->
          <div class="lg:col-span-2">
            <div class="bg-white/[0.03] border border-white/8 rounded-2xl p-6 sm:p-7">
              <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">Get the weekly brief</p>
              <NewsletterForm align="left" cta="Subscribe" />
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* FAQ accordion "+" -> "x" on open. Written as a plain rule rather than
     Tailwind's group-open:rotate-45 so the rotation does not depend on the
     group-open variant or on Tailwind's --tw-* transform variable chain. */
  .faq-plus {
    transition: transform 0.2s ease;
  }
  details[open] .faq-plus {
    transform: rotate(45deg);
  }
</style>
