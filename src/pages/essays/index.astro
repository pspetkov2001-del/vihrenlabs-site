---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays')).sort(
  (a, b) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf(),
);

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Operator Essays — Vihren Labs',
  description:
    'Operator-voice essays on SAP S/4HANA migration, master data, IT procurement, enterprise transitions, and EU IT regulation (DORA, EU AI Act).',
  url: 'https://vihrenlabs.com/essays',
};
---

<Base
  title="Essays · Vihren Labs"
  description="Operator-voice essays on SAP S/4HANA migration, master data, IT procurement, enterprise transitions, and EU IT regulation — DORA, EU AI Act. Written from 15 years inside enterprise IT."
  schema={collectionSchema}
>
  <section class="relative px-6 py-24 sm:py-28 border-b border-white/5 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px] rounded-full"
           style="background: radial-gradient(ellipse at center, rgba(30,61,89,0.45) 0%, rgba(8,14,20,0) 70%);"></div>
    </div>
    <div class="relative max-w-3xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Operator essays</span>
      </div>
      <h1 class="font-black text-4xl sm:text-5xl leading-[0.98] tracking-tight mb-6">
        Notes from inside the enterprise IT stack.
      </h1>
      <p class="text-white/50 text-lg leading-relaxed">
        Operator-voice essays on SAP migrations, master data, IT procurement, enterprise
        transitions, and EU regulation — written from 15 years on both the vendor-distribution
        and buyer-operator sides. Real T-codes, real article numbers, real failure modes.
      </p>
    </div>
  </section>

  <section class="py-16 px-6">
    <div class="max-w-3xl mx-auto flex flex-col gap-4">
      {essays.map((essay) => (
        <a href={`/essays/${essay.slug}`}
           class="group block border border-white/8 rounded-2xl p-6 hover:border-[#E67E22]/30 transition-colors bg-white/[0.02]">
          <div class="flex items-center gap-3 mb-3 flex-wrap">
            <span class="font-mono text-[10px] text-[#E67E22] border border-[#E67E22]/30 bg-[#E67E22]/8 px-2 py-0.5 rounded tracking-wider uppercase">{essay.data.line}</span>
            <span class="font-mono text-[10px] text-white/30 tracking-wider">{essay.data.date}</span>
          </div>
          <h2 class="font-bold text-xl text-white/90 leading-snug mb-2 group-hover:text-white transition-colors">{essay.data.title}</h2>
          <p class="text-white/45 text-sm leading-relaxed">{essay.data.description}</p>
          <span class="inline-block mt-4 font-mono text-xs text-white/30 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase">Read &rarr;</span>
        </a>
      ))}
    </div>
  </section>
</Base>
