---
import Base from '../layouts/Base.astro';

// Free, ungated one-pagers. They are self-funnelling: each PDF prints the
// Assessment CTA on it, so an ungated download still drives to the gated
// Assessment (l/rmkje). Source PDFs/PNGs live in the video repo
// (ai-ready-operations/ep*/pack/11-cheat-sheet.*) and are copied into
// public/cheat-sheets/ — keep them in sync from that one source.
const ASSESSMENT_URL = 'https://vihrenlabs.gumroad.com/l/rmkje';

// SEASON 1 - the framework. This is the main set: the cornerstone plus one sheet
// per layer, and it is COMPLETE. Season 2 sheets live in their own section below
// so a first-time visitor sees a finished framework, not an open-ended pile.
const seasonOne = [
  {
    eyebrow: 'Cornerstone · all five layers',
    title: 'Why most AI projects fail before the model does',
    sub: 'The whole map on one page - the five operational layers, and the 60-second tell that reveals which one you\'re missing.',
    png: '/cheat-sheets/five-layers-cheat-sheet.png',
    pdf: '/cheat-sheets/five-layers-cheat-sheet.pdf',
  },
  {
    eyebrow: 'Layer 1 · Governance',
    title: 'Governance, not agents',
    sub: 'The five failure modes (four aren\'t technical), the six decision rights to name, and the autonomy ladder - Layer 1\'s Monday-morning move.',
    png: '/cheat-sheets/governance-cheat-sheet.png',
    pdf: '/cheat-sheets/governance-cheat-sheet.pdf',
  },
  {
    eyebrow: 'Layer 2 · Clean Data',
    title: 'An amplifier, not a brain',
    sub: 'The three checks before you deploy - identity, completeness, source of truth - and why bad data stops looking broken and starts looking persuasive.',
    png: '/cheat-sheets/clean-data-cheat-sheet.png',
    pdf: '/cheat-sheets/clean-data-cheat-sheet.pdf',
  },
  {
    eyebrow: 'Layer 3 · Standardized Processes',
    title: 'Branches, not secrets',
    sub: 'The four moves that actually standardize a process, the two things an agent does with an exception nobody wrote down, and the count that tells you whether you are ready.',
    png: '/cheat-sheets/standardized-processes-cheat-sheet.png',
    pdf: '/cheat-sheets/standardized-processes-cheat-sheet.pdf',
  },
  {
    eyebrow: 'Layer 4 · Controls',
    title: 'Safety systems, not paperwork',
    sub: 'The five controls an agent needs on day one - access, audit trail, rollback, monitoring, a human - and the autonomy dial that says how much leash it has earned.',
    png: '/cheat-sheets/controls-cheat-sheet.png',
    pdf: '/cheat-sheets/controls-cheat-sheet.pdf',
  },
  {
    eyebrow: 'Layer 5 · Operating Model',
    title: 'A home, not applause',
    sub: 'Building an AI system is a project; keeping it valuable is an operational capability. The owner, the funding line and the roadmap that decide whether a successful pilot survives its own applause.',
    png: '/cheat-sheets/operating-model-cheat-sheet.png',
    pdf: '/cheat-sheets/operating-model-cheat-sheet.pdf',
  },
];

// SEASON 2 - the studies. Same one-page treatment applied to the numbers everyone
// is arguing about. Ongoing: one lands with each episode, so this list grows.
const seasonTwo = [
  {
    eyebrow: 'The 95% study',
    title: '95% of AI pilots fail. The reason isn\'t the AI.',
    sub: 'What the MIT study actually said - the three root causes behind the 95%, and why every one of them is an operations problem rather than a model problem.',
    png: '/cheat-sheets/95-percent-fail-cheat-sheet.png',
    pdf: '/cheat-sheets/95-percent-fail-cheat-sheet.pdf',
  },
  {
    eyebrow: 'The five maturity levels',
    title: 'Five levels. Where you actually sit.',
    sub: 'The 5x5 matrix on one page - ad hoc to AI-ready on every layer, the level-three line you should not automate below, and the rule that decides your score: your readiness is the lowest of the five, never the average.',
    png: '/cheat-sheets/maturity-levels-cheat-sheet.png',
    pdf: '/cheat-sheets/maturity-levels-cheat-sheet.pdf',
  },
  {
    eyebrow: 'The abandonment jump',
    title: 'Abandonment isn\'t the verdict. It\'s the bill.',
    sub: 'The 42% jump and the more honest 46% underneath it - where scrapped pilots actually die (governance and the operating model), and the three-question graduation test to run before the next green light.',
    png: '/cheat-sheets/abandonment-cheat-sheet.png',
    pdf: '/cheat-sheets/abandonment-cheat-sheet.pdf',
  },
  {
    eyebrow: 'The 13% that didn\'t move',
    title: 'Same 13%. Three years of spending.',
    sub: 'Cisco\'s three-flat-years finding decoded - the 4x pilot-to-production gap, the 54% whose networks cannot carry the load, and the double-the-budget test that tells you whether money would change anything at all.',
    png: '/cheat-sheets/thirteen-percent-cheat-sheet.png',
    pdf: '/cheat-sheets/thirteen-percent-cheat-sheet.pdf',
  },
  {
    eyebrow: 'Inside an AI Center of Excellence',
    title: 'A yes-machine, not a gate.',
    sub: 'The anatomy of an AI CoE on one page - what it owns versus what it only advises on, the funding test that decides whether it can refuse at all, the three artefacts that make it auditable, and the four ways it quietly stops governing.',
    png: '/cheat-sheets/ai-coe-cheat-sheet.png',
    pdf: '/cheat-sheets/ai-coe-cheat-sheet.pdf',
  },
];

// The Season 2 index. Live rows link the PDF; the rest carry a "Coming" badge and
// ship the day their episode publishes - the same discipline the five layers used.
// Every one of these is already written and rendered in the episode's own pack, so
// nothing here is a promise the factory cannot keep.
const seasonTwoMap = [
  { n: '01', label: 'The 95% study',        desc: 'what the MIT report actually found',        pdf: '/cheat-sheets/95-percent-fail-cheat-sheet.pdf' },
  { n: '02', label: 'The five maturity levels', desc: 'ad hoc to AI-ready, scored honestly',   pdf: '/cheat-sheets/maturity-levels-cheat-sheet.pdf' },
  { n: '03', label: 'The abandonment jump', desc: 'why working pilots get scrapped anyway',    pdf: '/cheat-sheets/abandonment-cheat-sheet.pdf' },
  { n: '04', label: 'Only 13% are ready',   desc: 'three years of spending moved it nothing',  pdf: '/cheat-sheets/thirteen-percent-cheat-sheet.pdf' },
  { n: '05', label: 'Inside an AI CoE',     desc: 'the operating model, end to end',           pdf: '/cheat-sheets/ai-coe-cheat-sheet.pdf' },
  { n: '06', label: 'AI-ready data',        desc: 'not clean data - ready for a named decision', pdf: null },
  { n: '07', label: 'The adoption gap',     desc: 'everyone uses AI, few can show the impact', pdf: null },
  { n: '08', label: 'The use-case gate',    desc: 'GO, PILOT or PARK, worked end to end',      pdf: null },
  { n: '09', label: 'Agent washing',        desc: 'how few "agentic" vendors are the real thing', pdf: null },
];

// Full five-layer set for the overview map. Available = has a pdf; the rest are "coming".
const layerMap = [
  { n: '◆',  label: 'The Five Layers',        desc: 'the whole framework on one page',                  pdf: '/cheat-sheets/five-layers-cheat-sheet.pdf', cornerstone: true },
  { n: '01', label: 'Governance',             desc: 'who owns AI - and how you decide what ships',       pdf: '/cheat-sheets/governance-cheat-sheet.pdf' },
  { n: '02', label: 'Clean Data',             desc: 'one source of truth, or the agent scales the mess', pdf: '/cheat-sheets/clean-data-cheat-sheet.pdf' },
  { n: '03', label: 'Standardized Processes', desc: 'consistent enough to automate at all',              pdf: '/cheat-sheets/standardized-processes-cheat-sheet.pdf' },
  { n: '04', label: 'Controls',               desc: 'catch, audit, and roll back a fast mistake',        pdf: '/cheat-sheets/controls-cheat-sheet.pdf' },
  { n: '05', label: 'Operating Model',        desc: 'who owns it after the launch demo',                 pdf: '/cheat-sheets/operating-model-cheat-sheet.pdf' },
];

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI-Ready Operations cheat sheets - Vihren Labs',
  description:
    'Free one-page cheat sheets from The Five Layers of AI-Ready Operations - the layer, the tells that reveal you are missing it, and the Monday-morning move. Free, no email.',
  url: 'https://www.vihrenlabs.com/cheat-sheets',
};
---

<Base
  title="Cheat Sheets"
  description="Free one-page cheat sheets from The Five Layers of AI-Ready Operations - governance, clean data, and more. The layer, the tells that reveal you're missing it, and the Monday-morning move. Free, no email."
  schema={collectionSchema}
>
  <!-- ═══ HERO ══════════════════════════════════════════════════════════ -->
  <section class="relative px-6 py-24 sm:py-28 border-b border-white/5 overflow-hidden blueprint-pattern">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[900px] h-[500px] rounded-full"
           style="background: radial-gradient(ellipse at center, rgba(30,61,89,0.45) 0%, rgba(8,14,20,0) 70%);"></div>
    </div>
    <div class="relative max-w-4xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Free · one page each</span>
      </div>
      <h1 class="font-black text-4xl sm:text-5xl leading-[0.98] tracking-tight mb-6">
        The Five Layers, one page each.
      </h1>
      <p class="text-white/50 text-lg leading-relaxed max-w-2xl">
        The complete framework from <a href="https://www.youtube.com/@vihrenlabs" target="_blank" rel="noopener noreferrer" class="text-white/70 hover:text-[#E67E22] underline underline-offset-4 decoration-white/20 transition-colors">The Five Layers of AI-Ready Operations</a> - each sheet is a single layer, the tells that reveal you're missing it, and the one Monday-morning move. Free, no email. The version to forward to whoever owns AI where you work. Below the set, the Season 2 studies get the same one-page treatment.
      </p>
    </div>
  </section>

  <!-- ═══ SEASON 1 GRID - the main set ══════════════════════════════════ -->
  <section class="py-16 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">Season 1 · the framework</span>
      </div>
      <h2 class="font-black text-2xl sm:text-3xl leading-tight mb-3">The Five Layers - the complete set</h2>
      <p class="text-white/45 text-base leading-relaxed max-w-2xl mb-10">
        Six sheets, nothing held back: the whole map on one page, then one page per layer. Start with the cornerstone if you are new - it tells you which of the five you are missing in about sixty seconds.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {seasonOne.map((s) => (
          <a href={s.pdf} download
             class="group flex flex-col rounded-2xl border border-white/8 bg-white/[0.02] overflow-hidden card-hover">
            <div class="overflow-hidden border-b border-white/8">
              <img src={s.png} alt={`${s.eyebrow} - ${s.title} cheat sheet`} loading="lazy" width="1080" height="1660"
                   class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.02]" />
            </div>
            <div class="flex flex-col flex-1 p-5">
              <span class="font-mono text-[10px] text-[#E67E22] mb-2 tracking-wider uppercase">{s.eyebrow}</span>
              <h3 class="font-bold text-base text-white/90 leading-snug mb-1.5">{s.title}</h3>
              <p class="text-white/40 text-sm leading-relaxed flex-1">{s.sub}</p>
              <span class="inline-flex items-center gap-2 mt-4 font-mono text-xs text-white/40 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Download PDF
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SEASON 1 INDEX (five-layer map) ═══════════════════════════════ -->
  <section class="pb-4 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-px bg-[#E67E22]"></div>
        <span class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase">The set, at a glance</span>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/[0.02] overflow-hidden">
        {layerMap.map((L) => (
          L.pdf ? (
            <a href={L.pdf} download
               class:list={["group flex items-center gap-4 px-5 py-3.5 border-b border-white/5 last:border-b-0 transition-colors", L.cornerstone ? "bg-[#E67E22]/[0.05] hover:bg-[#E67E22]/[0.09]" : "hover:bg-white/[0.02]"]}>
              <span class:list={["font-mono text-xs w-7 shrink-0 text-center", L.cornerstone ? "text-[#E67E22]" : "text-[#E67E22]/80"]}>{L.n}</span>
              <div class="flex-1 min-w-0">
                <span class="font-bold text-sm text-white/90">{L.label}</span>
                <span class="text-white/40 text-sm"> - {L.desc}</span>
              </div>
              <span class="font-mono text-[10px] text-white/35 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase whitespace-nowrap shrink-0 inline-flex items-center gap-1.5">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                PDF
              </span>
            </a>
          ) : (
            <div class="flex items-center gap-4 px-5 py-3.5 border-b border-white/5 last:border-b-0">
              <span class="font-mono text-xs w-7 shrink-0 text-center text-white/25">{L.n}</span>
              <div class="flex-1 min-w-0">
                <span class="font-bold text-sm text-white/45">{L.label}</span>
                <span class="text-white/25 text-sm"> - {L.desc}</span>
              </div>
              <span class="font-mono text-[10px] text-white/25 border border-white/8 px-2 py-0.5 rounded tracking-wider uppercase whitespace-nowrap shrink-0">Coming</span>
            </div>
          )
        ))}
      </div>
      <p class="text-white/30 text-xs font-mono mt-4 tracking-wider">
        All five layers plus the cornerstone. Nothing in this set is coming later - it is finished.
      </p>
    </div>
  </section>

  <!-- ═══ SEASON 2 - the studies (separate, ongoing) ═════════════════════
       Deliberately below the finished Season 1 set and visually quieter: a
       first-time visitor should meet a complete framework first, not an
       open-ended pile. Live sheets are cards; the rest are honest "Coming"
       rows that ship the day their episode publishes. ═══════════════════ -->
  <section class="pt-20 pb-4 px-6 border-t border-white/5 mt-16">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-3 mb-3">
        <div class="w-8 h-px bg-white/25"></div>
        <span class="font-mono text-white/45 text-xs tracking-[0.2em] uppercase">Season 2 · the studies</span>
      </div>
      <h2 class="font-black text-2xl sm:text-3xl leading-tight mb-3">The numbers everyone is arguing about</h2>
      <p class="text-white/45 text-base leading-relaxed max-w-2xl mb-10">
        Same one-page treatment, applied to the studies and headlines rather than the framework: what the number actually measured, where the failure really sat, and the move it argues for. One lands with each episode.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {seasonTwo.map((s) => (
          <a href={s.pdf} download
             class="group flex flex-col rounded-2xl border border-white/8 bg-white/[0.02] overflow-hidden card-hover">
            <div class="overflow-hidden border-b border-white/8">
              <img src={s.png} alt={`Season 2 - ${s.title} cheat sheet`} loading="lazy" width="1080" height="1660"
                   class="w-full h-auto block transition-transform duration-500 group-hover:scale-[1.02]" />
            </div>
            <div class="flex flex-col flex-1 p-5">
              <span class="font-mono text-[10px] text-[#E67E22] mb-2 tracking-wider uppercase">{s.eyebrow}</span>
              <h3 class="font-bold text-base text-white/90 leading-snug mb-1.5">{s.title}</h3>
              <p class="text-white/40 text-sm leading-relaxed flex-1">{s.sub}</p>
              <span class="inline-flex items-center gap-2 mt-4 font-mono text-xs text-white/40 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" />
                </svg>
                Download PDF
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ SEASON 2 INDEX (what has landed, what is coming) ══════════════ -->
  <section class="pt-12 pb-4 px-6">
    <div class="max-w-3xl mx-auto">
      <div class="flex items-center gap-3 mb-6">
        <div class="w-8 h-px bg-white/25"></div>
        <span class="font-mono text-white/45 text-xs tracking-[0.2em] uppercase">The season, at a glance</span>
      </div>
      <div class="rounded-2xl border border-white/8 bg-white/[0.02] overflow-hidden">
        {seasonTwoMap.map((L) => (
          L.pdf ? (
            <a href={L.pdf} download
               class="group flex items-center gap-4 px-5 py-3.5 border-b border-white/5 last:border-b-0 transition-colors hover:bg-white/[0.02]">
              <span class="font-mono text-xs w-7 shrink-0 text-center text-[#E67E22]/80">{L.n}</span>
              <div class="flex-1 min-w-0">
                <span class="font-bold text-sm text-white/90">{L.label}</span>
                <span class="text-white/40 text-sm"> - {L.desc}</span>
              </div>
              <span class="font-mono text-[10px] text-white/35 group-hover:text-[#E67E22] transition-colors tracking-wider uppercase whitespace-nowrap shrink-0 inline-flex items-center gap-1.5">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5M16.5 12 12 16.5m0 0L7.5 12m4.5 4.5V3" /></svg>
                PDF
              </span>
            </a>
          ) : (
            <div class="flex items-center gap-4 px-5 py-3.5 border-b border-white/5 last:border-b-0">
              <span class="font-mono text-xs w-7 shrink-0 text-center text-white/25">{L.n}</span>
              <div class="flex-1 min-w-0">
                <span class="font-bold text-sm text-white/45">{L.label}</span>
                <span class="text-white/25 text-sm"> - {L.desc}</span>
              </div>
              <span class="font-mono text-[10px] text-white/25 border border-white/8 px-2 py-0.5 rounded tracking-wider uppercase whitespace-nowrap shrink-0">Coming</span>
            </div>
          )
        ))}
      </div>
      <p class="text-white/30 text-xs font-mono mt-4 tracking-wider">
        A new one lands with each episode. <a href="/#newsletter" class="text-white/45 hover:text-[#E67E22] transition-colors">Subscribe</a> to catch them, or <a href="https://www.youtube.com/@vihrenlabs" target="_blank" rel="noopener noreferrer" class="text-white/45 hover:text-[#E67E22] transition-colors">watch the season</a>.
      </p>
    </div>
  </section>

  <!-- ═══ ASSESSMENT CTA — the primary email-capture path ═══════════════
       The individual sheets above stay ungated (frictionless + shareable);
       this is the "want the whole framework, by email" option that captures
       the lead into Beehiiv via the free Assessment (l/rmkje). Kept honest:
       it points at the Assessment (covers all five layers as a scored check),
       NOT a claim that it bundles the individual sheet PDFs. ═══════════════ -->
  <section class="py-20 px-6 border-t border-white/5">
    <div class="max-w-3xl mx-auto">
      <div class="relative overflow-hidden rounded-3xl border border-[#E67E22]/30 bg-gradient-to-br from-[#1E3D59]/40 to-[#080E14]/80 p-8 sm:p-12 text-center">
        <div class="absolute top-0 right-0 w-80 h-80 rounded-full opacity-10 pointer-events-none"
             style="background: radial-gradient(ellipse at top right, #E67E22, transparent 70%);" aria-hidden="true"></div>
        <div class="relative">
          <p class="font-mono text-[#E67E22] text-xs tracking-[0.2em] uppercase mb-4">Want all five in one go?</p>
          <h2 class="font-black text-3xl sm:text-4xl leading-tight mb-5">Get the whole framework - scored on your own org.</h2>
          <p class="text-white/55 text-base leading-relaxed mb-8 max-w-xl mx-auto">
            Grab the sheets one at a time above - or get the whole thing in one place. The free <span class="text-white/80">AI-Ready Operations Assessment</span> turns all five layers into a readiness check you run on your own organization - a maturity scale from "ad hoc" to "AI-ready" that shows your weakest layer before you spend a cent on tooling. Enter your email and it lands in your inbox.
          </p>
          <a href={ASSESSMENT_URL} target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center justify-center gap-2 bg-[#E67E22] hover:bg-[#CA6F1E] text-white font-mono text-sm font-bold uppercase tracking-widest px-8 py-4 rounded-lg transition-colors">
            Get the free assessment
          </a>
          <p class="text-white/35 text-xs mt-5 font-mono tracking-wider">Free · straight to your inbox · no spam</p>
          <p class="text-white/30 text-xs mt-4 leading-relaxed max-w-xl mx-auto">
            Education, not consulting, legal, or vendor advice. Tool-agnostic. Go deeper in the <a href="/products" class="text-white/45 hover:text-[#E67E22] transition-colors">operator library</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
