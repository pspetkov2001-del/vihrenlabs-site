---
const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 backdrop-blur-md bg-[#080E14]/80">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-8 h-8 bg-[#E67E22] rounded flex items-center justify-center flex-shrink-0">
        <span class="text-white font-bold text-sm font-mono">V</span>
      </div>
      <span class="text-white font-semibold text-base tracking-tight">Vihren Labs</span>
    </a>

    <nav class="flex items-center gap-8">
      <a
        href="/about"
        class:list={[
          'text-sm font-medium transition-colors',
          currentPath === '/about' || currentPath === '/about/'
            ? 'text-[#E67E22]'
            : 'text-white/50 hover:text-white'
        ]}
      >
        About
      </a>
      <a
        href="https://vihrenlabs.gumroad.com"
        target="_blank"
        rel="noopener noreferrer"
        class="text-sm font-semibold bg-[#E67E22] hover:bg-[#CA6F1E] text-white px-5 py-2 rounded-full transition-colors"
      >
        Shop &rarr;
      </a>
    </nav>
  </div>
</header>

<!-- Spacer for fixed nav -->
<div class="h-[65px]"></div>
