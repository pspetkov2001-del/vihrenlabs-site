---
import Logo from './Logo.astro';
const currentPath = Astro.url.pathname;
const links = [
  { href: '/products', label: 'Products', active: currentPath === '/products' || currentPath === '/products/' },
  { href: '/cheat-sheets', label: 'Cheat Sheets', active: currentPath.startsWith('/cheat-sheets') },
  { href: '/guides', label: 'Guides', active: currentPath.startsWith('/guides') },
  { href: '/essays', label: 'Essays', active: currentPath.startsWith('/essays') },
  { href: '/about', label: 'About', active: currentPath === '/about' || currentPath === '/about/' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 backdrop-blur-md bg-[#080E14]/80">
  <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
      <Logo class="w-7 h-7 shrink-0 text-[#E67E22]" />
      <span class="text-white font-display font-bold text-lg tracking-tight">Vihren Labs</span>
    </a>

    <!-- Desktop nav (>= sm) -->
    <nav class="hidden sm:flex items-center gap-6 sm:gap-8">
      {links.map((l) => (
        <a
          href={l.href}
          class:list={[
            'font-mono text-xs uppercase tracking-widest transition-colors whitespace-nowrap',
            l.active ? 'text-[#E67E22]' : 'text-white/50 hover:text-white',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a
        href="https://vihrenlabs.gumroad.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-xs font-bold uppercase tracking-widest bg-[#E67E22] hover:bg-[#CA6F1E] text-white px-5 py-2.5 rounded-lg transition-colors whitespace-nowrap"
      >
        Shop &rarr;
      </a>
    </nav>

    <!-- Mobile hamburger (< sm) -->
    <button
      id="nav-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="sm:hidden inline-flex items-center justify-center w-10 h-10 -mr-2 text-white/70 hover:text-white flex-shrink-0"
    >
      <svg id="nav-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="nav-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18 18 6" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu panel -->
  <nav id="mobile-menu" class="hidden sm:hidden border-t border-white/5 bg-[#080E14]/95 backdrop-blur-md px-6 py-3">
    {links.map((l) => (
      <a
        href={l.href}
        class:list={[
          'block py-2.5 font-mono text-sm uppercase tracking-widest transition-colors',
          l.active ? 'text-[#E67E22]' : 'text-white/70 hover:text-white',
        ]}
      >
        {l.label}
      </a>
    ))}
    <a
      href="https://vihrenlabs.gumroad.com"
      target="_blank"
      rel="noopener noreferrer"
      class="mt-3 inline-block font-mono text-xs font-bold uppercase tracking-widest bg-[#E67E22] hover:bg-[#CA6F1E] text-white px-5 py-2.5 rounded-lg transition-colors"
    >
      Shop &rarr;
    </a>
  </nav>
</header>

<!-- Spacer for fixed nav -->
<div class="h-[65px]"></div>

<script is:inline>
  (function () {
    var toggle = document.getElementById('nav-toggle');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('nav-icon-open');
    var iconClose = document.getElementById('nav-icon-close');
    if (!toggle || !menu) return;
    toggle.addEventListener('click', function () {
      var isHidden = menu.classList.toggle('hidden');
      toggle.setAttribute('aria-expanded', String(!isHidden));
      if (iconOpen) iconOpen.classList.toggle('hidden', !isHidden);
      if (iconClose) iconClose.classList.toggle('hidden', isHidden);
    });
  })();
</script>
