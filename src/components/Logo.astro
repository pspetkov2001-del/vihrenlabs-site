---
/**
 * Vihren Labs mark — "contour peak + reflection" (concept B, 2026-06).
 * A topographic summit (Vihren / Pirin) over a waterline with a faded
 * reflection that also reads as a V. Uses currentColor, so set the colour
 * on the element via a text-* class. Decorative — always paired with the
 * "Vihren Labs" wordmark, so it's aria-hidden.
 *
 * Props:
 *   class      — sizing + colour utilities (default w-7 h-7)
 *   reflection — include the waterline + reflection (for larger sizes).
 *                Omit for nav/footer/favicon scale, where it just muddies.
 */
interface Props {
  class?: string;
  reflection?: boolean;
}
const { class: className = 'w-7 h-7', reflection = false } = Astro.props;
---
{reflection ? (
  <svg class={className} viewBox="0 0 32 44" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M4 24 L16 7 L28 24" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
    <path d="M10 24 L16 15 L22 24" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round" stroke-linecap="round" opacity="0.5"/>
    <circle cx="16" cy="7" r="1.8" fill="currentColor"/>
    <line x1="5" y1="27.5" x2="27" y2="27.5" stroke="currentColor" stroke-width="1.2" opacity="0.22"/>
    <path d="M9 31 L16 41 L23 31" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" opacity="0.28"/>
  </svg>
) : (
  <svg class={className} viewBox="0 0 32 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M4 24 L16 7 L28 24" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round" stroke-linecap="round"/>
    <path d="M10 24 L16 15 L22 24" stroke="currentColor" stroke-width="2.1" stroke-linejoin="round" stroke-linecap="round" opacity="0.5"/>
    <circle cx="16" cy="7" r="1.8" fill="currentColor"/>
  </svg>
)}
