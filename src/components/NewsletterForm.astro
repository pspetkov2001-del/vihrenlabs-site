---
/**
 * ConvertKit newsletter form.
 *
 * To activate:
 * 1. Create a free account at convertkit.com
 * 2. Create a form → Embed → choose "Inline"
 * 3. In the embed code, find data-uid="XXXX" — that is your FORM_UID
 * 4. Add to Vercel: Settings → Environment Variables → PUBLIC_CONVERTKIT_UID=XXXX
 * 5. Redeploy. Done.
 *
 * Without the env var, the form renders but submissions go nowhere (safe placeholder).
 */
const uid = import.meta.env.PUBLIC_CONVERTKIT_UID ?? '';
const actionUrl = uid
  ? `https://app.convertkit.com/forms/${uid}/subscriptions`
  : '#';
const isLive = uid.length > 0;
---

<form
  action={actionUrl}
  method="post"
  class="w-full max-w-md mx-auto"
>
  <div class="flex flex-col sm:flex-row gap-3">
    <input
      type="email"
      name="email_address"
      placeholder="your@email.com"
      required
      autocomplete="email"
      class="flex-1 bg-white/5 border border-white/10 focus:border-[#E67E22] text-white placeholder-white/30 px-5 py-3.5 rounded-full text-sm outline-none transition-colors"
    />
    <button
      type="submit"
      class="bg-[#E67E22] hover:bg-[#CA6F1E] text-white font-semibold px-7 py-3.5 rounded-full text-sm transition-colors whitespace-nowrap"
    >
      Subscribe &rarr;
    </button>
  </div>

  <input type="hidden" name="utf8" value="✓" />

  <p class="text-white/25 text-xs mt-4 text-center">
    One essay a week. No spam. Unsubscribe any time.
  </p>

  {!isLive && (
    <p class="text-[#E67E22]/40 text-xs mt-2 text-center font-mono">
      Set PUBLIC_CONVERTKIT_UID in Vercel env vars to activate
    </p>
  )}
</form>
