---
/**
 * Self-managed newsletter form → POST /api/subscribe (Vercel serverless).
 *
 * Provider-aware backend:
 *  - Beehiiv (canonical per D-023) — set BEEHIIV_API_KEY + BEEHIIV_PUBLICATION_ID in Vercel.
 *    Welcome sequence W1 delivers the free Operator Standard PDF.
 *  - Resend (legacy fallback) — set RESEND_API_KEY + RESEND_AUDIENCE_ID + RESEND_FROM_EMAIL.
 *  - Neither configured → form silently no-ops (UX stays clean during setup).
 *
 * See api/subscribe.js header for full setup steps + Beehiiv migration plan.
 *
 * Optional props:
 *  - align: 'left' (default) | 'center' — text alignment for the helper line
 *  - cta:   button label (default "Subscribe →")
 */
const { align = 'left', cta = 'Subscribe →' } = Astro.props;
const helperAlign = align === 'center' ? 'text-center' : 'text-left';
---

<form
  id="nl-form"
  class="w-full max-w-md"
  novalidate
>
  <div class="flex flex-col sm:flex-row gap-3">
    <input
      id="nl-email"
      type="email"
      name="email"
      placeholder="your@email.com"
      required
      autocomplete="email"
      class="flex-1 min-w-0 bg-white/5 border border-white/10 focus:border-[#E67E22] text-white placeholder-white/30 px-5 py-3.5 rounded-lg text-sm outline-none transition-colors font-mono"
    />
    <button
      id="nl-btn"
      type="submit"
      class="shrink-0 bg-[#E67E22] hover:bg-[#CA6F1E] text-white font-mono font-bold uppercase tracking-wider px-6 py-3.5 rounded-lg text-xs transition-colors whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
    >
      {cta}
    </button>
  </div>

  <p id="nl-status" class={`text-xs mt-4 h-4 ${helperAlign}`} aria-live="polite"></p>

  <p class={`text-white/25 text-xs mt-1 ${helperAlign}`}>
    One operator essay a week. No spam. Unsubscribe any time.
  </p>
</form>

<script>
  const form   = document.getElementById('nl-form')   as HTMLFormElement;
  const emailEl = document.getElementById('nl-email') as HTMLInputElement;
  const btn    = document.getElementById('nl-btn')    as HTMLButtonElement;
  const status = document.getElementById('nl-status') as HTMLParagraphElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = emailEl.value.trim();
    if (!email) return;

    btn.disabled = true;
    btn.textContent = 'Subscribing…';
    status.textContent = '';
    status.className = 'text-xs mt-4 text-center h-4';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });

      const data = await res.json().catch(() => ({}));

      if (res.ok) {
        status.textContent = "You're in. First essay coming soon.";
        status.className = 'text-[#E67E22] text-xs mt-4 text-center h-4';
        emailEl.value = '';
        btn.textContent = 'Subscribed ✓';
        // keep button disabled — success state
      } else {
        status.textContent = data.error ?? 'Something went wrong. Try again.';
        status.className = 'text-red-400 text-xs mt-4 text-center h-4';
        btn.disabled = false;
        btn.textContent = 'Subscribe →';
      }
    } catch {
      status.textContent = 'Network error. Check your connection and try again.';
      status.className = 'text-red-400 text-xs mt-4 text-center h-4';
      btn.disabled = false;
      btn.textContent = 'Subscribe →';
    }
  });
</script>
