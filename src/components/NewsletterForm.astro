---
/**
 * Beehiiv newsletter form.
 *
 * To activate:
 * 1. Create a free account at beehiiv.com (free up to 2,500 subscribers)
 * 2. Settings → Publication → scroll to "Publication ID" — copy it (starts with "pub_")
 * 3. Add to Vercel: Settings → Environment Variables → PUBLIC_BEEHIIV_PUB_ID=pub_xxxxxxxx
 * 4. Redeploy. Done.
 *
 * Without the env var, the form renders but submissions go nowhere (safe placeholder).
 */
const pubId = import.meta.env.PUBLIC_BEEHIIV_PUB_ID ?? '';
const isLive = pubId.length > 0;
---

<form
  action={isLive ? `https://app.beehiiv.com/subscribe` : '#'}
  method="post"
  class="w-full max-w-md mx-auto"
>
  {isLive && <input type="hidden" name="publication_id" value={pubId} />}

  <div class="flex flex-col sm:flex-row gap-3">
    <input
      type="email"
      name="email"
      placeholder="your@email.com"
      required
      autocomplete="email"
      class="flex-1 bg-white/5 border border-white/10 focus:border-[#E67E22] text-white placeholder-white/30 px-5 py-3.5 rounded-full text-sm outline-none transition-colors"
    />
    <button
      type="submit"
      class="bg-[#E67E22] hover:bg-[#CA6F1E] text-white font-semibold px-7 py-3.5 rounded-full text-sm transition-colors whitespace-nowrap"
    >
      Subscribe &rarr;
    </button>
  </div>

  <p class="text-white/25 text-xs mt-4 text-center">
    One essay a week. No spam. Unsubscribe any time.
  </p>

  {!isLive && (
    <p class="text-[#E67E22]/40 text-xs mt-2 text-center font-mono">
      Set PUBLIC_BEEHIIV_PUB_ID in Vercel env vars to activate
    </p>
  )}
</form>
