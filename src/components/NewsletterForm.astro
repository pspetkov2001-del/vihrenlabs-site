---
/**
 * NewsletterForm.astro — ConvertKit-embedded newsletter signup form.
 *
 * SETUP (T-052 Fix 4 — founder action required):
 *   1. Sign up at https://convertkit.com (free tier)
 *   2. Create a form named "Vihren Labs — Operator field notes"
 *   3. Dashboard → Forms → Embed → "HTML form" tab
 *   4. Replace REPLACE_FORM_ID and REPLACE_FORM_UID with your values
 *
 * Until the IDs are filled in, the form renders but submissions 404.
 * Replace the two REPLACE_* strings and push — nothing else to change.
 */

const FORM_ID  = "REPLACE_FORM_ID";   // e.g. "1234567"
const FORM_UID = "REPLACE_FORM_UID";  // e.g. "a1b2c3d4e5"
---

<form
  action={`https://app.convertkit.com/forms/${FORM_ID}/subscriptions`}
  method="post"
  data-sv-form={FORM_ID}
  data-uid={FORM_UID}
  data-format="inline"
  data-version="5"
  class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
>
  <input
    type="email"
    name="email_address"
    required
    placeholder="you@company.com"
    class="flex-1 px-4 py-3 rounded-lg bg-navy-light/40 border border-orange/30 text-grey-light placeholder:text-white/25 font-mono text-sm focus:outline-none focus:border-orange transition-colors"
  />
  <button
    type="submit"
    class="px-6 py-3 rounded-lg bg-orange hover:bg-orange-dark text-white font-mono text-sm font-semibold transition-colors whitespace-nowrap"
  >
    Get field notes &rarr;
  </button>
</form>

<p class="text-xs text-white/25 font-mono text-center mt-4">
  ~1 essay per week. No spam. Unsubscribe any time.
</p>

<!-- ConvertKit embed script — loads async, no render-blocking -->
<script src="https://f.convertkit.com/ckjs/ck.5.js" defer></script>
