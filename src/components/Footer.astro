---
const year = new Date().getFullYear();
---

<footer class="border-t border-white/8 mt-0">
  <div class="max-w-6xl mx-auto px-6 pt-12 pb-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-2.5">
      <span class="material-symbols-outlined text-[#E67E22] text-xl flex-shrink-0">terminal</span>
      <span class="text-white/40 text-sm">
        &copy; {year} Vihren Labs Ltd. &middot; Sofia, Bulgaria
        <span class="block text-white/25 text-xs mt-1">Operator-grade templates for the enterprise IT stack &middot; built by a 15-year enterprise IT operator</span>
      </span>
    </div>

    <div class="flex items-center gap-x-6 gap-y-3 text-sm flex-wrap">
      <a href="/products" class="text-white/30 hover:text-[#E67E22] transition-colors">Products</a>
      <a href="/guides" class="text-white/30 hover:text-[#E67E22] transition-colors">Guides</a>
      <a href="/essays" class="text-white/30 hover:text-[#E67E22] transition-colors">Essays</a>
      <a href="/free" class="text-white/30 hover:text-[#E67E22] transition-colors">Free</a>
      <a href="/about" class="text-white/30 hover:text-[#E67E22] transition-colors">About</a>
      <a href="https://www.etsy.com/shop/FreelancebyPetko" target="_blank" rel="noopener noreferrer" class="text-white/30 hover:text-[#E67E22] transition-colors">Etsy</a>
      <a href="https://vihrenlabs.gumroad.com" target="_blank" rel="noopener noreferrer" class="text-white/30 hover:text-[#E67E22] transition-colors">Gumroad</a>
      <a href="/privacy" class="text-white/30 hover:text-[#E67E22] transition-colors">Privacy</a>
      <a href="/imprint" class="text-white/30 hover:text-[#E67E22] transition-colors">Imprint</a>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-6">
    <div class="ledger-line opacity-20"></div>
  </div>
  <div class="max-w-6xl mx-auto px-6 pt-6 pb-12">
    <p class="text-white/25 text-xs leading-relaxed max-w-3xl">
      Vihren Labs is an independent educational-publishing business. Views expressed are solely my own and do not represent any current or former employer.
    </p>
  </div>
</footer>
