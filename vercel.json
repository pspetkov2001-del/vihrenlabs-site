{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": "astro",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "^vihrenlabs\\.com$" }],
      "destination": "https://www.vihrenlabs.com/",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "^vihrenlabs\\.com$" }],
      "destination": "https://www.vihrenlabs.com/:path",
      "permanent": true
    },
    {
      "source": "/paths",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/paths/",
      "destination": "/products",
      "permanent": true
    },
    {
      "source": "/lines/programme-delivery",
